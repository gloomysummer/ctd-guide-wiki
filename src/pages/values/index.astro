---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import valuesData from "../../data/values.json";

const tocHeadings = [
  { depth: 2, slug: "trade-calculator", text: "Interactive Trade Calculator" },
  { depth: 2, slug: "value-table", text: "CTD Values List (Update 5)" },
  { depth: 2, slug: "fairness-methodology", text: "Fairness Band Methodology" },
  { depth: 2, slug: "evidence-dossier", text: "Source Dossier" },
];

const totalUnits = valuesData.length;
const godlyUnits = valuesData.filter(u => u.rarity === 'Godly').length;
const mythicUnits = valuesData.filter(u => u.rarity === 'Mythic').length;

// Only the 24 units with a published point value can participate in arithmetic.
// The other 16 are real units with no sourced value — treating them as "worth
// zero" silently is what makes a calculator give a confident wrong answer, so
// they are passed separately and disclosed in the UI instead.
const pricedUnits = valuesData.filter(u => u.value > 0);

// The snapshot date is read from the data, never typed into the page. A hand-written
// date is how a table ends up sourced to a list it was not actually read from.
const snapshotDates = [...new Set(
  valuesData.map(u => u.source?.retrievedAt).filter(Boolean)
)].sort() as string[];
const snapshotDate = snapshotDates.length
  ? new Date(snapshotDates[snapshotDates.length - 1] + "T00:00:00Z")
      .toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : null;

// Stamped into feedback so a complaint about "the calculator is broken" can be
// matched to the build that was live when it was written.
const buildStamp = new Date().toISOString().slice(0, 16).replace("T", " ") + " UTC";

// Packed for the client-side gap advisor: short keys keep the inline payload small.
const calcUnits = pricedUnits.map(u => ({
  id: u.id, name: u.name, value: u.value, rarity: u.rarity, trend: u.trend,
}));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cameraman Tower Defense Trade Calculator & Value List",
    "applicationCategory": "GameUtility",
    "operatingSystem": "Web",
    "url": `${siteConfig.siteUrl}/values/`,
    "description": "Interactive trade calculator and trading value directory for Cameraman Tower Defense on Roblox.",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Values", "item": `${siteConfig.siteUrl}/values/` },
    ],
  },
];
---

<BaseLayout
  title="Cameraman Tower Defense Values & CTD Value List"
  description={`Cameraman Tower Defense values list and CTD trade calculator, read from the live Vaulted Values X list on ${snapshotDate ?? "11 November 2026"}. ${totalUnits} units, demand and trade parity.`}
  canonical="/values/"
  jsonLd={jsonLd}
>
  <div class="container article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">Values</span>
    </nav>

    <header class="guide-header">
      <div class="guide-badges">
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">P0 INTERACTIVE TOOL</span>
        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">UPDATE 5 VALUE INDEX</span>
        <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3);">{totalUnits} UNITS INDEXED</span>
      </div>
      <h1>Cameraman Tower Defense Values & Trade Calculator</h1>
      <p class="guide-lead">
        Cameraman Tower Defense trade values read live from the Vaulted Values X list on <strong>{snapshotDate ?? "an unrecorded date"}</strong>. Check any offer across 4 slots for Win / Fair / Lose parity, and compare demand ratings for all {totalUnits} units.
      </p>
      <p class="value-provenance">
        Point values read from the <a href="https://cameraman-td.vaultedvaluesx.com/value-list" target="_blank" rel="noopener">Vaulted Values X</a> list on <strong>{snapshotDate ?? "a date not recorded"}</strong>. That list is revised after every patch, so treat these figures as indicative rather than a quote — the calculator is for sanity-checking an offer, not for pricing a trade you have already agreed.
      </p>
    </header>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main">
        <!-- Mobile Table of Contents -->
        <details class="mobile-toc">
          <summary>
            <span>ON THIS PAGE (TABLE OF CONTENTS)</span>
            <span>▾</span>
          </summary>
          <div class="mobile-toc-inner">
            <ol class="toc-step-list">
              {tocHeadings.map((item, idx) => (
                <li class={`toc-step-item depth-${item.depth}`}>
                  <a href={`#${item.slug}`} class="toc-step-link">
                    <span class="toc-step-num">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="toc-step-title">{item.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>

        <!-- SECTION 1: INTERACTIVE TRADE CALCULATOR -->
        <section id="trade-calculator" class="calc-section">
          <div class="section-title-wrap">
            <h2>Interactive 4-Slot Trade Calculator</h2>
            <p class="section-desc">Select units for your side and their side. The calculator sums points, measures net difference, and evaluates the trade against the ±10% fairness band. When an offer is off balance it names the unit or pair that closes the gap, and flags deals where the points balance but the value direction does not.</p>
          </div>

          <div class="calculator-card">
            <!-- Verdict Banner -->
            <div id="calc-verdict-banner" class="verdict-banner status-even">
              <div class="verdict-status" id="verdict-text">EQUAL / FAIR (±0 PTS)</div>
              <div class="verdict-diff" id="verdict-sub">Add units to both sides to compute trade equity</div>
            </div>

            <div class="calc-grid">
              <!-- YOUR OFFER (LEFT) -->
              <div class="calc-column side-yours">
                <div class="column-header">
                  <h3>Your Offer (Give)</h3>
                  <div class="side-total-badge"><span id="your-total">0</span> pts</div>
                </div>
                <div class="slots-container" id="your-slots">
                  {[0, 1, 2, 3].map((slotIdx) => (
                    <div class="slot-row" data-side="your" data-slot={slotIdx}>
                      <span class="slot-number">#{slotIdx + 1}</span>
                      <select class="unit-select" aria-label={`Your Slot ${slotIdx + 1} Unit`}>
                        <option value="">-- Empty Slot --</option>
                        {valuesData.map((u) => (
                          <option value={u.id} data-val={u.value} data-rarity={u.rarity}>
                            {u.name} ({u.rarity}{u.value > 0 ? ` - ${u.value.toLocaleString()} pts` : ' - no published value'})
                          </option>
                        ))}
                      </select>
                      <input type="number" class="unit-qty" min="1" max="10" value="1" aria-label="Quantity" />
                      <div class="slot-subtotal">0</div>
                    </div>
                  ))}
                </div>
                <button type="button" class="btn-clear-side" id="clear-your-btn">Clear Your Side</button>
              </div>

              <!-- THEIR OFFER (RIGHT) -->
              <div class="calc-column side-theirs">
                <div class="column-header">
                  <h3>Their Offer (Receive)</h3>
                  <div class="side-total-badge"><span id="their-total">0</span> pts</div>
                </div>
                <div class="slots-container" id="their-slots">
                  {[0, 1, 2, 3].map((slotIdx) => (
                    <div class="slot-row" data-side="their" data-slot={slotIdx}>
                      <span class="slot-number">#{slotIdx + 1}</span>
                      <select class="unit-select" aria-label={`Their Slot ${slotIdx + 1} Unit`}>
                        <option value="">-- Empty Slot --</option>
                        {valuesData.map((u) => (
                          <option value={u.id} data-val={u.value} data-rarity={u.rarity}>
                            {u.name} ({u.rarity}{u.value > 0 ? ` - ${u.value.toLocaleString()} pts` : ' - no published value'})
                          </option>
                        ))}
                      </select>
                      <input type="number" class="unit-qty" min="1" max="10" value="1" aria-label="Quantity" />
                      <div class="slot-subtotal">0</div>
                    </div>
                  ))}
                </div>
                <button type="button" class="btn-clear-side" id="clear-their-btn">Clear Their Side</button>
              </div>
            </div>

            <!-- Trade Stats Summary -->
            <div class="calc-summary-bar">
              <div class="stat-pill">
                <span class="lbl">Your Total:</span>
                <strong id="summary-your">0</strong>
              </div>
              <div class="stat-pill">
                <span class="lbl">Their Total:</span>
                <strong id="summary-their">0</strong>
              </div>
              <div class="stat-pill">
                <span class="lbl">Difference:</span>
                <strong id="summary-diff">+0</strong>
              </div>
              <div class="stat-pill">
                <span class="lbl">Profit Margin:</span>
                <strong id="summary-margin">0.0%</strong>
              </div>
              <button type="button" class="btn-reset-all" id="reset-all-btn">Reset All</button>
            </div>

            <!-- Units with no published value must be disclosed even when the
                 gap advisor stays quiet, so this sits outside that panel. -->
            <p class="gap-caveat" id="gap-caveat" hidden></p>

            <!-- Gap-Fill Advisor -->
            <div id="gap-panel" class="gap-panel" hidden>
              <div class="gap-head">
                <span class="gap-title">Close the gap</span>
                <span class="gap-sub" id="gap-sub"></span>
              </div>
              <div class="gap-list" id="gap-list"></div>
            </div>

            <!-- Risk note + shareable trade link -->
            <div class="calc-tools-row">
              <div id="risk-note" class="risk-note" hidden></div>
              <button type="button" class="btn-share" id="share-btn">Copy trade link</button>
            </div>

            <!-- Reader feedback. Collapsed by default: a tool that works should
                 not open with a complaint box. What it sends is deliberately
                 thin — two questions and the deal on screen, so we can reproduce
                 the problem without asking the reader to describe it. -->
            <details class="calc-feedback" id="calc-feedback">
              <summary>
                <span class="fb-sum">Something wrong with this calculator?</span>
                <span class="fb-hint">30 seconds, goes straight to our issue sheet</span>
              </summary>
              <form id="fb-form" novalidate>
                <fieldset class="fb-sat">
                  <legend>How does it feel overall?</legend>
                  <label><input type="radio" name="satisfaction" value="good" /><span>Works fine</span></label>
                  <label><input type="radio" name="satisfaction" value="meh" /><span>A bit confusing</span></label>
                  <label><input type="radio" name="satisfaction" value="bad" /><span>Couldn't use it</span></label>
                </fieldset>

                <label class="fb-field">
                  <span class="fb-label">What went wrong?</span>
                  <textarea id="fb-complaint" rows="3" maxlength="1200"
                    placeholder="Couldn't find my unit / the verdict made no sense / these numbers look off / buttons don't work on my phone"></textarea>
                </label>

                <label class="fb-field">
                  <span class="fb-label">What were you trying to do? <em>optional</em></span>
                  <input id="fb-wanted" type="text" maxlength="300"
                    placeholder="e.g. work out whether 3 TV Spiders buy one Chaos Cameraman" />
                </label>

                <!-- Honeypot: hidden from people, filled by anything that walks the DOM. -->
                <div class="fb-hp" aria-hidden="true">
                  <label>Website<input id="fb-website" type="text" tabindex="-1" autocomplete="off" /></label>
                </div>

                <div class="fb-actions">
                  <button type="submit" id="fb-submit">Send</button>
                  <span class="fb-status" id="fb-status" role="status"></span>
                </div>
                <p class="fb-note">
                  This includes the trade currently on screen so we can reproduce it.
                  No name, no email, nothing that identifies you.
                </p>
              </form>
            </details>
          </div>
        </section>

        <!-- 广告位 1/3：计算器之后、价值表之前。
             这个站 90% 的搜索意图是 calculator，所以第一个位放在计算器正下方，
             用户算完一次必定经过它；而不是放页首把工具本身挤下去。 -->
        <AdSlot zone="banner-300x250" />

        <!-- SECTION 2: VALUE TABLE -->
        <section id="value-table" style="margin-top: 3.5rem;">
          <div class="section-title-wrap">
            <h2>CTD Values List & Vaulted Values Directory</h2>
            <p class="section-desc">Complete CTD values list benchmarked against the live Vaulted Values X list after Update 5. Search {totalUnits} units, filter by rarity, and check live trading demand ratings.</p>
          </div>

          <div class="vaulted-values-intel-banner">
            <div class="intel-banner-badge">VAULTED VALUES X TIERS & CTD VALUES BENCHMARKS</div>
            <p>
              Trading values in Roblox Cameraman Tower Defense follow strict community demand brackets. Godly and top Exclusive carries command multi-thousand point valuations with high trade demand, while standard Mythics and rebalanced Legendaries serve as liquid bridge units. Click <strong>+You</strong> or <strong>+Them</strong> on any unit to populate the trade calculator.
            </p>
            <div class="intel-tier-pills">
              <span class="intel-pill"><strong>Godly Top:</strong> UTTVM (5,425 pts)</span>
              <span class="intel-pill"><strong>Top Exclusive:</strong> TV Spider (15,000 pts)</span>
              <span class="intel-pill"><strong>Top Mythic:</strong> Chaos (3,800 pts)</span>
              <span class="intel-pill"><strong>Godly Carry:</strong> UTCM (3,100 pts)</span>
            </div>
          </div>

          <VideoEmbed
            id="7QBiS599euI"
            title="Cameraman Tower Defense Value List: What Every Unit Is Worth After Update 4"
            description="Official community unit trading value list and economy breakdown for Cameraman Tower Defense Update 4."
            channel="Vaulted Values X"
            uploadDate="2026-10-26"
            captionLabel="Value list source video"
          />

          <!-- Controls -->
          <div class="table-controls">
            <div class="search-box">
              <input type="text" id="unit-table-search" placeholder="Search unit by name (e.g. Titan, Chaos, Glitch)..." />
            </div>
            <div class="filter-pills" id="rarity-filters">
              <button type="button" class="pill active" data-filter="all">All ({totalUnits})</button>
              <button type="button" class="pill" data-filter="Godly">Godly ({godlyUnits})</button>
              <button type="button" class="pill" data-filter="Mythic">Mythic ({mythicUnits})</button>
              <button type="button" class="pill" data-filter="Legendary">Legendary</button>
              <button type="button" class="pill" data-filter="Epic">Epic</button>
              <button type="button" class="pill" data-filter="Rare">Rare</button>
              <button type="button" class="pill" data-filter="Basic">Basic</button>
            </div>
          </div>

          <div class="table-responsive">
            <div class="table-scroll">
              <table class="values-data-table" id="values-table-el">
              <thead>
                <tr>
                  <th>Unit</th>
                  <th>Rarity</th>
                  <th>Trade Value</th>
                  <th>Demand</th>
                  <th>Trend</th>
                  <th>Tier</th>
                  <th>Quick Add</th>
                </tr>
              </thead>
              <tbody>
                {valuesData.map((u) => (
                  <tr data-name={u.name.toLowerCase()} data-rarity={u.rarity} data-id={u.id} data-val={u.value}>
                    <td>
                      <div class="unit-cell">
                        <img src={`/images/units/${u.id}.webp`} alt={u.name} class="unit-mini-thumb" loading="lazy" width="48" height="30" />
                        <div>
                          <a href={`/units/${u.id}/`} class="unit-table-link"><strong>{u.name}</strong></a>
                          <div class="unit-cat-hint">{u.category}</div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class={`rarity-tag tag-${u.rarity.toLowerCase()}`}>{u.rarity}</span>
                    </td>
                    <td>
                      {u.value > 0 ? <><span class="value-number">{u.value.toLocaleString()}</span> <small class="pts-lbl">pts</small></> : <span class="value-number na">—</span> <small class="pts-lbl">unpublished</small>}
                    </td>
                    <td>
                      <div class="demand-meter">
                        <span class="demand-val">{u.demand > 0 ? `${u.demand}/10` : "—"}</span>
                        <div class="bar-bg"><div class="bar-fill" style={`width: ${u.demand * 10}%;`}></div></div>
                      </div>
                    </td>
                    <td>
                      <span class={`trend-badge trend-${u.trend.toLowerCase()}`}>
                        {u.trend === 'Rising' ? '▲ Rising'
                          : u.trend === 'Dropping' ? '▼ Dropping'
                          : u.trend === 'Unstable' ? '◆ Unstable'
                          : u.trend === 'Volatile' ? '◇ Volatile'
                          : u.trend === 'Stable' ? '● Stable'
                          : '— Unknown'}
                      </span>
                    </td>
                    <td>
                      <span class={`tier-pill tier-${u.tier.toLowerCase()}`}>{u.tier}</span>
                    </td>
                    <td>
                      <div class="quick-add-group">
                        <button type="button" class="btn-add-calc btn-add-you" data-id={u.id} title="Add to Your Offer">+You</button>
                        <button type="button" class="btn-add-calc btn-add-them" data-id={u.id} title="Add to Their Offer">+Them</button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
              </div>
          </div>
        </section>

        <!-- 广告位 2/3 在侧栏：DualSidebar 自带 sticky 160x600。
             这里不再插位 —— 加上它会变成桌面 4 个位，超过每页 3 个的甜点区。 -->

        <!-- SECTION 3: FAIRNESS METHODOLOGY -->
        <section id="fairness-methodology" style="margin-top: 3.5rem;">
          <h2>Fairness Band Methodology & Trade Rules</h2>
          <div class="methodology-grid">
            <div class="method-card">
              <h3>Fairness Band (±10%)</h3>
              <p>
                Roblox Cameraman Tower Defense item liquidity fluctuates based on summon crates and patch notes. A trade within <strong>±10% net point parity</strong> is considered mutually equitable (Fair Trade) on the CTD values list.
              </p>
            </div>
            <div class="method-card">
              <h3>Win / Big Win Thresholds</h3>
              <p>
                Trades yielding a <strong>+10% to +30% profit margin</strong> qualify as a <strong>Win (W)</strong>. Any exchange yielding <strong>&gt; +30%</strong> represents an overwhelming <strong>Big Win (BW)</strong> on Vaulted Values benchmarks.
              </p>
            </div>
            <div class="method-card">
              <h3>Overpay vs Demand</h3>
              <p>
                High-demand units (like <em>TV Spider</em> at 9/10 or <em>Engineer Cameraman</em> at 8/10) command an inherent overpay premium. Do not trade high-demand Godlies for low-demand fodder epics at raw value parity.
              </p>
            </div>
          </div>
        </section>

        <!-- SECTION 4: EVIDENCE DOSSIER -->
        <section id="evidence-dossier" style="margin-top: 3.5rem;">
          <h2>Source Dossier & Ledger</h2>
          <div class="evidence-box">
            <div class="evidence-header">
              <span class="evidence-shield">🛡️ OFFICIAL AUDIT LEDGER</span>
              <span class="evidence-status">SOURCE READ {snapshotDate ?? "unknown"}</span>
            </div>
            <div class="evidence-body">
              <p><strong>Primary Valuation Source:</strong> Vaulted Values X live value list, read {snapshotDate ?? "an unrecorded date"}.</p>
              <p><strong>Cross-Verification Video Anchor:</strong> <a href="https://www.youtube.com/watch?v=7QBiS599euI" target="_blank" rel="noopener">YouTube (Vaulted Values X Update 4 Valuation Ledger, ID: 7QBiS599euI)</a> — the 25 October archive the price-history timelines are built on.</p>
              <p><strong>Patch Alignment:</strong> Values reflect the live list after <strong>Update 5 (UTTVM, live 4 November 2026)</strong>. The timeline benchmarks on each unit page are anchored to the earlier <code>2026-10-25</code> list, which is why a unit's history and its current value differ by a revision.</p>
              <blockquote>
                <em>"Trading point valuations are anchored to spin pity equivalents, crate drop rates (0.01% Godly, 0.1% Mythic), and active secondary market exchange ratios."</em>
              </blockquote>
            </div>
          </div>
        </section>
      </article>

      <!-- Sidebar -->
      <DualSidebar
        tocHeadings={tocHeadings}
        currentUrl="/values/"
      />
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ calcUnits }}>
  // Interactive Trade Calculator Client Logic
  (function() {
    const valuesMap = {};
    document.querySelectorAll('#values-table-el tbody tr').forEach(tr => {
      const id = tr.dataset.id;
      const val = parseInt(tr.dataset.val, 10) || 0;
      valuesMap[id] = val;
    });

    const yourSlots = document.querySelectorAll('#your-slots .slot-row');
    const theirSlots = document.querySelectorAll('#their-slots .slot-row');
    const yourTotalEl = document.getElementById('your-total');
    const theirTotalEl = document.getElementById('their-total');
    const summaryYour = document.getElementById('summary-your');
    const summaryTheir = document.getElementById('summary-their');
    const summaryDiff = document.getElementById('summary-diff');
    const summaryMargin = document.getElementById('summary-margin');
    const verdictBanner = document.getElementById('calc-verdict-banner');
    const verdictText = document.getElementById('verdict-text');
    const verdictSub = document.getElementById('verdict-sub');

    function calculateTrade() {
      let yourSum = 0;
      let theirSum = 0;

      yourSlots.forEach(row => {
        const sel = row.querySelector('.unit-select');
        const qty = parseInt(row.querySelector('.unit-qty').value, 10) || 1;
        const val = sel.value ? (valuesMap[sel.value] || 0) : 0;
        const sub = val * qty;
        row.querySelector('.slot-subtotal').textContent = sub > 0 ? sub.toLocaleString() : '0';
        yourSum += sub;
      });

      theirSlots.forEach(row => {
        const sel = row.querySelector('.unit-select');
        const qty = parseInt(row.querySelector('.unit-qty').value, 10) || 1;
        const val = sel.value ? (valuesMap[sel.value] || 0) : 0;
        const sub = val * qty;
        row.querySelector('.slot-subtotal').textContent = sub > 0 ? sub.toLocaleString() : '0';
        theirSum += sub;
      });

      yourTotalEl.textContent = yourSum.toLocaleString();
      theirTotalEl.textContent = theirSum.toLocaleString();
      summaryYour.textContent = yourSum.toLocaleString() + ' pts';
      summaryTheir.textContent = theirSum.toLocaleString() + ' pts';

      const diff = theirSum - yourSum;
      summaryDiff.textContent = (diff >= 0 ? '+' : '') + diff.toLocaleString() + ' pts';

      let margin = 0;
      if (yourSum > 0) {
        margin = (diff / yourSum) * 100;
      }
      summaryMargin.textContent = (margin >= 0 ? '+' : '') + margin.toFixed(1) + '%';

      // Verdict evaluation
      verdictBanner.className = 'verdict-banner';
      if (yourSum === 0 && theirSum === 0) {
        verdictBanner.classList.add('status-even');
        verdictText.textContent = 'EQUAL / FAIR (±0 PTS)';
        verdictSub.textContent = 'Add units to both sides to compute trade equity';
      } else if (yourSum === 0) {
        verdictBanner.classList.add('status-bw');
        verdictText.textContent = 'FREE GIFT / MASSIVE WIN';
        verdictSub.textContent = `Receiving ${theirSum.toLocaleString()} pts for free`;
      } else if (theirSum === 0) {
        verdictBanner.classList.add('status-bl');
        verdictText.textContent = 'GIVING AWAY / UNBALANCED';
        verdictSub.textContent = `Giving away ${yourSum.toLocaleString()} pts without return`;
      } else {
        const absDiff = Math.abs(diff);
        const ratio = margin;

        if (Math.abs(ratio) <= 10) {
          verdictBanner.classList.add('status-fair');
          verdictText.textContent = `FAIR TRADE (±${absDiff.toLocaleString()} PTS)`;
          verdictSub.textContent = `Within the standard ±10% fairness corridor (${margin >= 0 ? '+' : ''}${margin.toFixed(1)}%)`;
        } else if (ratio > 30) {
          verdictBanner.classList.add('status-bw');
          verdictText.textContent = `BIG WIN (+${diff.toLocaleString()} PTS)`;
          verdictSub.textContent = `Massive advantage! You gain +${margin.toFixed(1)}% extra market value`;
        } else if (ratio > 10) {
          verdictBanner.classList.add('status-win');
          verdictText.textContent = `WIN (+${diff.toLocaleString()} PTS)`;
          verdictSub.textContent = `Profitable offer with a +${margin.toFixed(1)}% surplus`;
        } else if (ratio < -30) {
          verdictBanner.classList.add('status-bl');
          verdictText.textContent = `BIG LOSE (${diff.toLocaleString()} PTS)`;
          verdictSub.textContent = `Severe overpay! You are losing ${Math.abs(margin).toFixed(1)}% value`;
        } else {
          verdictBanner.classList.add('status-lose');
          verdictText.textContent = `LOSE (${diff.toLocaleString()} PTS)`;
          verdictSub.textContent = `Underpaid offer. You are taking a ${Math.abs(margin).toFixed(1)}% deficit`;
        }
      }

      updateAdvisor(yourSum, theirSum);
      syncHash();
    }

    /* ---------------------------------------------------------------
       Trading advisor: turns a verdict into an action.
       A number tells you the trade is off by 340 points; it does not tell
       you what to ask for. That gap is the single most common question in
       every trade chat, so it is computed here instead of left to the user.
       --------------------------------------------------------------- */

    const gapPanel = document.getElementById('gap-panel');
    const gapList = document.getElementById('gap-list');
    const gapSub = document.getElementById('gap-sub');
    const gapCaveat = document.getElementById('gap-caveat');
    const riskNote = document.getElementById('risk-note');

    function sidePicks(slots) {
      const picked = [];
      slots.forEach(row => {
        const sel = row.querySelector('.unit-select');
        const id = sel.value;
        if (!id) return;
        const qty = parseInt(row.querySelector('.unit-qty').value, 10) || 1;
        const meta = calcUnits.find(u => u.id === id);
        // Unpriced units are not in calcUnits, so read their label off the
        // option rather than printing a raw slug back at the user.
        const label = sel.options[sel.selectedIndex]
          ? sel.options[sel.selectedIndex].text.replace(/\s*\(.*\)\s*$/, '').trim()
          : id;
        picked.push({
          id, qty,
          value: meta ? meta.value : 0,
          name: meta ? meta.name : label,
          trend: meta ? meta.trend : 'Unknown',
          priced: Boolean(meta),
        });
      });
      return picked;
    }

    function nameList(items) {
      return items.map(p => p.qty > 1 ? `${p.name} ×${p.qty}` : p.name).join(', ');
    }

    function renderGapSuggestions(yourSum, theirSum, diff, ownedIds) {
      const base = yourSum;
      const band = base * 0.10;
      gapList.innerHTML = '';

      if (yourSum === 0 || theirSum === 0) {
        gapPanel.hidden = true;
        return;
      }
      gapPanel.hidden = false;

      if (Math.abs(diff) <= band) {
        gapSub.textContent = `Already inside the ±10% fair band — no filler needed.`;
        return;
      }

      const owedBy = diff > 0 ? 'them' : 'you';
      const need = Math.abs(diff);
      gapSub.textContent = owedBy === 'them'
        ? `They are short ${need.toLocaleString()} pts. Ask for one of these.`
        : `You are short ${need.toLocaleString()} pts. Offer one of these.`;

      // Candidates: the priced units not already in the deal, single or paired.
      // 22 units -> 22 singles + 231 pairs, cheap enough to score on every keystroke.
      const pool = calcUnits.filter(u => !ownedIds.has(u.id));
      const candidates = [];
      for (let i = 0; i < pool.length; i++) {
        candidates.push({ sum: pool[i].value, items: [pool[i]] });
        for (let j = i + 1; j < pool.length; j++) {
          candidates.push({ sum: pool[i].value + pool[j].value, items: [pool[i], pool[j]] });
        }
      }

      const scored = candidates.map(c => {
        // Adding to the deficient side moves the difference toward zero by `sum`.
        const newDiff = diff - Math.sign(diff) * c.sum;
        const newBase = owedBy === 'you' ? base + c.sum : base;
        const newMargin = newBase > 0 ? (newDiff / newBase) * 100 : 0;
        return { ...c, newDiff, newMargin };
      })
        .filter(c => Math.abs(c.newMargin) <= 10 && Math.abs(c.newDiff) < Math.abs(diff))
        .sort((a, b) => a.items.length - b.items.length
          || Math.abs(a.newDiff) - Math.abs(b.newDiff)
          || a.sum - b.sum)
        .slice(0, 3);

      if (!scored.length) {
        gapSub.textContent = need / base > 0.5
          ? `The gap is ${need.toLocaleString()} pts — more than half your side. That is a different trade, not a filler add-on.`
          : `No single unit or pair lands inside ±10% of that gap. Try two mid-tier units instead.`;
        return;
      }

      scored.forEach(c => {
        const chip = document.createElement('div');
        chip.className = 'gap-chip';
        const thumbs = c.items.map(u => `<img src="/images/units/${u.id}.webp" alt="" width="28" height="18" loading="lazy">`).join('');
        const label = c.items.map(u => u.name).join(' + ');
        const sign = c.newMargin >= 0 ? '+' : '';
        chip.innerHTML = `${thumbs}<span class="gap-chip-name">${label}</span>`
          + `<span class="gap-chip-val">${c.sum.toLocaleString()} pts</span>`
          + `<span class="gap-chip-result">${sign}${c.newMargin.toFixed(1)}%</span>`;
        gapList.appendChild(chip);
      });
    }

    function renderRiskNote(yourPicks, theirPicks, yourSum, theirSum) {
      const risingGiven = yourPicks.filter(p => p.trend === 'Rising');
      const droppingReceived = theirPicks.filter(p => p.trend === 'Dropping');
      const droppingGiven = yourPicks.filter(p => p.trend === 'Dropping');
      const risingReceived = theirPicks.filter(p => p.trend === 'Rising');

      const notes = [];
      if (risingGiven.length && droppingReceived.length) {
        notes.push(`<strong>Direction risk:</strong> you give ${nameList(risingGiven)} (Rising) for ${nameList(droppingReceived)} (Dropping). The points can balance while the value moves against you next update.`);
      }
      if (droppingGiven.length && risingReceived.length) {
        notes.push(`<strong>Direction in your favour:</strong> you give ${nameList(droppingGiven)} (Dropping) for ${nameList(risingReceived)} (Rising).`);
      }

      if (!notes.length) {
        riskNote.hidden = true;
        riskNote.innerHTML = '';
        return;
      }
      riskNote.hidden = false;
      riskNote.innerHTML = notes.join(' ')
        + ` <span class="risk-source">Trend column from the sourced Update 4 value list — a heuristic, not a guarantee.</span>`;
    }

    function updateAdvisor(yourSum, theirSum) {
      const yourPicks = sidePicks(yourSlots);
      const theirPicks = sidePicks(theirSlots);
      const diff = theirSum - yourSum;
      const ownedIds = new Set([...yourPicks, ...theirPicks].map(p => p.id));

      renderGapSuggestions(yourSum, theirSum, diff, ownedIds);
      renderRiskNote(yourPicks, theirPicks, yourSum, theirSum);

      // Some units carry no published point value. Saying nothing lets a user
      // read a confident verdict off a deal that contains units we cannot price.
      const unpricedUsed = [...yourPicks, ...theirPicks].filter(p => !p.priced);
      if (unpricedUsed.length) {
        gapCaveat.hidden = false;
        gapCaveat.textContent = `${unpricedUsed.length} unit${unpricedUsed.length > 1 ? 's' : ''} in this deal `
          + `(${nameList(unpricedUsed)}) ${unpricedUsed.length > 1 ? 'have' : 'has'} no published point value and `
          + `${unpricedUsed.length > 1 ? 'count' : 'counts'} as 0 — the verdict above only reflects the ${calcUnits.length} priced units.`;
      } else {
        gapCaveat.hidden = true;
      }
    }

    /* ---------------------------------------------------------------
       Shareable trade link. State lives in the URL hash, so a trade can be
       pasted into Discord for the other trader to inspect, and a user who
       closes the tab does not lose the offer they were building.
       --------------------------------------------------------------- */

    const shareBtn = document.getElementById('share-btn');

    function encodeSide(slots) {
      // Slot index is encoded so a restored trade keeps the arrangement the
      // sender built, instead of silently repacking units into the first slots.
      return [...slots].map((row, idx) => {
        const id = row.querySelector('.unit-select').value;
        if (!id) return null;
        const qty = parseInt(row.querySelector('.unit-qty').value, 10) || 1;
        return `${idx}:${id}*${qty}`;
      }).filter(Boolean).join(',');
    }

    function syncHash() {
      const state = `${encodeSide(yourSlots)}|${encodeSide(theirSlots)}`;
      const next = state === '|' ? '' : `#t=${state}`;
      if (next !== (location.hash || '')) {
        history.replaceState(null, '', next || location.pathname + location.search);
      }
    }

    function applyHash() {
      const raw = location.hash.replace(/^#t=/, '');
      if (!location.hash.startsWith('#t=') || !raw) return false;
      const [yourRaw, theirRaw] = raw.split('|');
      const fill = (slots, spec) => {
        if (!spec) return;
        spec.split(',').forEach((entry, fallbackIdx) => {
          const [slotRaw, rest] = entry.split(':');
          const [id, qtyRaw] = (rest || slotRaw).split('*');
          const slotIdx = rest ? parseInt(slotRaw, 10) : fallbackIdx;
          const row = slots[slotIdx];
          if (!row || !calcUnits.some(u => u.id === id)) return;
          row.querySelector('.unit-select').value = id;
          const q = parseInt(qtyRaw, 10);
          row.querySelector('.unit-qty').value = (q >= 1 && q <= 10) ? q : 1;
        });
      };
      fill(yourSlots, yourRaw);
      fill(theirSlots, theirRaw);
      return true;
    }

    shareBtn.addEventListener('click', async () => {
      syncHash();
      const url = location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch (e) {
        const tmp = document.createElement('textarea');
        tmp.value = url;
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand('copy');
        tmp.remove();
      }
      const original = shareBtn.textContent;
      shareBtn.textContent = 'Link copied ✓';
      shareBtn.classList.add('copied');
      setTimeout(() => {
        shareBtn.textContent = original;
        shareBtn.classList.remove('copied');
      }, 2000);
    });

    // Attach listeners to slots
    document.querySelectorAll('.calc-column .unit-select, .calc-column .unit-qty').forEach(el => {
      el.addEventListener('change', calculateTrade);
      el.addEventListener('input', calculateTrade);
    });

    document.getElementById('clear-your-btn').addEventListener('click', () => {
      yourSlots.forEach(row => {
        row.querySelector('.unit-select').value = '';
        row.querySelector('.unit-qty').value = '1';
      });
      calculateTrade();
    });

    document.getElementById('clear-their-btn').addEventListener('click', () => {
      theirSlots.forEach(row => {
        row.querySelector('.unit-select').value = '';
        row.querySelector('.unit-qty').value = '1';
      });
      calculateTrade();
    });

    document.getElementById('reset-all-btn').addEventListener('click', () => {
      document.querySelectorAll('.unit-select').forEach(s => s.value = '');
      document.querySelectorAll('.unit-qty').forEach(q => q.value = '1');
      calculateTrade();
    });

    // Quick Add buttons from Table
    function findEmptySlot(slots) {
      for (let row of slots) {
        const sel = row.querySelector('.unit-select');
        if (!sel.value) return row;
      }
      return null;
    }

    document.querySelectorAll('.btn-add-you').forEach(btn => {
      btn.addEventListener('click', () => {
        const uid = btn.dataset.id;
        const target = findEmptySlot(yourSlots) || yourSlots[0];
        target.querySelector('.unit-select').value = uid;
        calculateTrade();
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    document.querySelectorAll('.btn-add-them').forEach(btn => {
      btn.addEventListener('click', () => {
        const uid = btn.dataset.id;
        const target = findEmptySlot(theirSlots) || theirSlots[0];
        target.querySelector('.unit-select').value = uid;
        calculateTrade();
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    // Table Search and Rarity Filter
    const searchInput = document.getElementById('unit-table-search');
    const rarityBtns = document.querySelectorAll('#rarity-filters .pill');
    const tableRows = document.querySelectorAll('#values-table-el tbody tr');

    let currentFilter = 'all';
    let searchQuery = '';

    function filterTable() {
      tableRows.forEach(tr => {
        const name = tr.dataset.name;
        const rarity = tr.dataset.rarity;
        const matchSearch = !searchQuery || name.includes(searchQuery);
        const matchRarity = currentFilter === 'all' || rarity.toLowerCase() === currentFilter.toLowerCase();
        tr.style.display = (matchSearch && matchRarity) ? '' : 'none';
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterTable();
      });
    }

    rarityBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        rarityBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter;
        filterTable();
      });
    });

    // Restore a trade pasted from a shared link before the first render, so the
    // opening state is the state that was shared rather than an empty calculator.
    applyHash();
    calculateTrade();
  })();
</script>

<script is:inline define:vars={{ buildStamp }}>
  // Reader feedback. Two questions and whatever the calculator is showing.
  //
  // A failed send is never pretended away: if the route is not configured the
  // reader is told nothing was recorded, and the note is kept in localStorage
  // and retried on the next visit rather than dropped on the floor.
  (() => {
    const form = document.getElementById('fb-form');
    if (!form) return;

    const details = document.getElementById('calc-feedback');
    const statusEl = document.getElementById('fb-status');
    const submitBtn = document.getElementById('fb-submit');
    const QUEUE_KEY = 'ctd-feedback-queue';
    let openedAt = 0;

    details.addEventListener('toggle', () => {
      if (details.open && !openedAt) openedAt = Date.now();
    });

    function readSide(selector) {
      const out = [];
      document.querySelectorAll(selector + ' .slot-row').forEach((row) => {
        const sel = row.querySelector('.unit-select');
        if (!sel || !sel.value) return;
        const opt = sel.options[sel.selectedIndex];
        const label = opt ? opt.text.replace(/\s*\(.*\)\s*$/, '').trim() : sel.value;
        const qtyEl = row.querySelector('.unit-qty');
        const qty = qtyEl ? Math.max(1, parseInt(qtyEl.value, 10) || 1) : 1;
        out.push(qty > 1 ? label + ' ×' + qty : label);
      });
      return out;
    }

    function dealSnapshot() {
      const yours = readSide('#your-slots');
      const theirs = readSide('#their-slots');
      if (!yours.length && !theirs.length) return '';
      const text = (id) => (document.getElementById(id)?.textContent || '').trim();
      return (
        'They give: ' + (theirs.join(', ') || 'nothing') +
        ' | You give: ' + (yours.join(', ') || 'nothing') +
        ' | Verdict: ' + text('verdict-text') +
        ' | Diff: ' + text('summary-diff') +
        ' | Margin: ' + text('summary-margin')
      );
    }

    function buildPayload() {
      const checked = form.querySelector('input[name="satisfaction"]:checked');
      return {
        satisfaction: checked ? checked.value : '',
        complaint: document.getElementById('fb-complaint').value,
        wanted: document.getElementById('fb-wanted').value,
        website: document.getElementById('fb-website').value,
        dwell: openedAt ? Date.now() - openedAt : 0,
        deal: dealSnapshot(),
        page: location.pathname,
        device: window.matchMedia('(pointer: coarse)').matches ? 'mobile' : 'desktop',
        viewport: window.innerWidth + '×' + window.innerHeight,
        referrer: document.referrer || '',
        version: buildStamp,
      };
    }

    async function post(payload) {
      const res = await fetch('/api/feedback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      return { ok: res.ok && data.ok === true, status: res.status, error: data.error || '' };
    }

    function queue(payload) {
      try {
        const items = JSON.parse(localStorage.getItem(QUEUE_KEY) || '[]');
        items.push(payload);
        localStorage.setItem(QUEUE_KEY, JSON.stringify(items.slice(-5)));
      } catch (_) { /* storage disabled — nothing else to do */ }
    }

    async function flushQueue() {
      let items;
      try {
        items = JSON.parse(localStorage.getItem(QUEUE_KEY) || '[]');
      } catch (_) { return; }
      if (!items.length) return;
      const keep = [];
      for (const item of items) {
        try {
          const r = await post(item);
          if (!r.ok) keep.push(item);
        } catch (_) { keep.push(item); }
      }
      try {
        if (keep.length) localStorage.setItem(QUEUE_KEY, JSON.stringify(keep));
        else localStorage.removeItem(QUEUE_KEY);
      } catch (_) { /* ignore */ }
    }

    function setStatus(msg, kind) {
      statusEl.textContent = msg;
      statusEl.className = 'fb-status' + (kind ? ' ' + kind : '');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = buildPayload();
      if (!payload.satisfaction && !payload.complaint.trim() && !payload.wanted.trim()) {
        setStatus('Pick a rating or write something first.', 'err');
        return;
      }

      submitBtn.disabled = true;
      setStatus('Sending…', '');
      try {
        const result = await post(payload);
        if (result.ok) {
          form.reset();
          setStatus('Thanks — that landed in our issue sheet.', 'ok');
        } else if (result.status === 503) {
          queue(payload);
          setStatus('Feedback is not wired up yet, so nothing was sent. Kept on this device.', 'err');
        } else {
          queue(payload);
          setStatus('Could not send that. Kept on this device and retried next visit.', 'err');
        }
      } catch (_) {
        queue(payload);
        setStatus('Could not send that. Kept on this device and retried next visit.', 'err');
      } finally {
        submitBtn.disabled = false;
      }
    });

    flushQueue();
  })();
</script>

