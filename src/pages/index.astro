---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import AdSlot from "../components/AdSlot.astro";
import { siteConfig } from "../config/site.config";
import { CHANNELS, TOTAL_GUIDES_COUNT } from "../config/channels";
import dossier from "../data/dossier.json";
import valuesData from "../data/values.json";
import codesData from "../data/verified-codes.json";

// Dynamic Roblox game name from API (strictly not hardcoded)
const dynamicGameName = dossier.metadata?.name || "[💰X2] Cameraman Tower Defense";
const developerName = dossier.metadata?.developer || "Aligators Games (Group 1111394813)";
const livePlaying = dossier.liveStats?.playing ?? 40000;
const totalVisits = dossier.liveStats?.visits ?? 69798000;
const ratingPercent = ((dossier.liveStats?.rating ?? 0.986) * 100).toFixed(1);

const totalUnitsCount = valuesData.length;
const activeCodesCount = codesData.activeCodes.length;

const CHANNEL_CARDS: Record<string, { image: string; alt: string }> = {
  values: { image: "/images/cards/card_values.webp", alt: "Cameraman Tower Defense Trade Calculator & Value List" },
  codes: { image: "/images/cards/card_codes.webp", alt: "Cameraman Tower Defense Promo Codes November 2026" },
  units: { image: "/images/cards/card_units.webp", alt: "Cameraman Tower Defense 39 Units Roster & Database" },
  "tier-list": { image: "/images/cards/card_tier_list.webp", alt: "Cameraman Tower Defense Meta Tier List Ranking" },
  guides: { image: "/images/cards/card_nightmare.webp", alt: "How to Solo Nightmare Mode in Cameraman Tower Defense" },
};

const CHANNEL_SUMMARIES: Record<string, string> = {
  values: "Real-time trading point valuations, 4-slot Win/Fair/Lose balance calculator, and liquidity demand ratings.",
  codes: "Daily verified working coin codes, one-click copy, and the mandatory 3-win redemption gate explanation.",
  units: "Complete stat index, summon drop rates, and trade values for all 39 Godly, Mythic, Legendary and Epic units.",
  "tier-list": "Comprehensive S-to-D meta tier list ranked after the Halloween Update 4 buffs.",
  guides: "Proven tactical blueprints for clearing 50-wave Nightmare mode solo, official Discord links, and shop guides.",
};

const OFFICIAL_SCREENSHOTS = [
  { src: "/images/screenshots/scene_0.webp", alt: "Cameraman Tower Defense Battle Arena and Track Defense" },
  { src: "/images/screenshots/scene_1.webp", alt: "Cameraman Tower Defense Toilet Invasions and Tower Placements" },
  { src: "/images/screenshots/scene_2.webp", alt: "Cameraman Tower Defense High Wave Action and Titan Blasters" },
  { src: "/images/screenshots/scene_3.webp", alt: "Cameraman Tower Defense Unit Upgrades and Co-op Gameplay" },
];

const faqItems = [
  {
    question: "What is Cameraman Tower Defense on Roblox?",
    answer: "Cameraman Tower Defense (Universe ID: 10762636904) is a strategic tower defense experience created by Aligators Games (aibat303e & iop_dev). Players place defensive cameramen, speakermen, and high-tech TV titans along the lane to stop waves of invading toilet swarms across multiple map difficulties.",
  },
  {
    question: "What is the newest unit in the latest update?",
    answer: "Update 4 (Halloween 2026) rebalanced the meta: Chaos Cameraman and Headless TV Man arrived as new Mythics, and the old legendaries were cut to 5 points each. The next content drop, the UTTVM update, is scheduled for November 4, 2026.",
  },
  {
    question: "How does the Cameraman Tower Defense trade calculator work?",
    answer: "The Cameraman Tower Defense trade calculator compares total market points across up to 4 units per side to determine trade parity based on the Vaulted Values list. Exchanges within ±10% are rated as a Fair Trade (F), offers with a +10% to +30% advantage represent a Win (W), gains above +30% are Big Wins (BW), and offers below -10% are classified as a Lose (L).",
    cta: { text: "Open the Cameraman Tower Defense trade calculator", href: "/values/#trade-calculator" },
  },
  {
    question: "Why does the game say I cannot redeem promo codes?",
    answer: "Cameraman Tower Defense has an anti-bot rule: you must achieve at least 3 match wins before code redemption unlocks. Once you have 3 wins on your account, open the in-game Shop and scroll to the bottom to input your codes.",
  },
  {
    question: "How do you solo Nightmare Mode in Cameraman Tower Defense?",
    answer: "Soloing Nightmare mode requires early farming with Pumpkin Farmers or Scientist Cameramen, slowing crowd-control from Glitch Cameraman, base restoration from Camera Repair Drones, and heavy AoE damage from Titan Cinemaman or Upgraded Titans.",
  },
  {
    question: "How many total units are currently in the game?",
    answer: "Following the Halloween and Spider content patches, Cameraman Tower Defense lists 39 distinct units ranging from Basic starters up to the Godly Upgraded Titan Cameraman (UTCM). The Upgraded Titan TV Man (UTTVM) is scheduled for the November 4 update and is not yet obtainable.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.siteName,
  url: siteConfig.siteUrl,
  description: "Authoritative wiki, interactive trade calculator, unit value list, and promo codes for Cameraman Tower Defense on Roblox.",
  publisher: {
    "@type": "Organization",
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
    logo: `${siteConfig.siteUrl}/favicon-96x96.png`,
  },
};
---

<BaseLayout
  title="CTD Guide | Cameraman Tower Defense Calculator"
  description="Authoritative Cameraman Tower Defense wiki and CTD calculator. Compare trade values, compute Win/Fair/Lose parity, redeem active codes, and check unit stats."
  canonical="/"
  jsonLd={[websiteJsonLd, faqJsonLd]}
>
  <!-- HERO SECTION: CINEMA FULL-BLEED SPLIT -->
  <header class="hero-bleed">
    <div class="hero-bg-media" style="background-image: url('/images/hero/hero_bg.webp');"></div>
    <div class="hero-lens-flare"></div>
    <div class="container hero-content">
      <div class="hero-grid">
        <!-- Left 58%: Authority Content & Triple CTA -->
        <div class="hero-copy">
          <div class="hero-live-pill">
            <span class="pulse-indicator"></span>
            <span class="live-title">{dynamicGameName}</span>
            <span class="live-sep">•</span>
            <span class="live-playing">{livePlaying.toLocaleString()} Playing</span>
          </div>

          <h1 class="hero-headline">
            Tactical Intel, Unit Values & Trade Calculator
          </h1>

          <p class="hero-lead">
            The definitive resource for <strong>{dynamicGameName}</strong> by {developerName}. Compute fair trade parity, redeem audited codes, and inspect the full 39-unit roster.
          </p>

          <!-- Triple CTA Matrix -->
          <div class="hero-cta-matrix">
            <a href="/values/" class="btn-cta btn-primary-cta">
              <span class="cta-icon">⚖️</span>
              <span class="cta-text">
                <strong>Trade Calculator</strong>
                <small>4-Slot W/F/L Values Tool</small>
              </span>
            </a>

            <a href="/codes/" class="btn-cta btn-secondary-cta">
              <span class="cta-icon">🎁</span>
              <span class="cta-text">
                <strong>Redeem Codes</strong>
                <small>{activeCodesCount} Active • November 2026</small>
              </span>
            </a>

            <a href="/units/" class="btn-cta btn-outline-cta">
              <span class="cta-icon">📸</span>
              <span class="cta-text">
                <strong>Units Database</strong>
                <small>All {totalUnitsCount} Units Roster</small>
              </span>
            </a>
          </div>
        </div>

        <!-- Right 42%: Official Showcase & Live Game Stats Card -->
        <div class="hero-aside">
          <div class="tactical-terminal-card">
            <div class="terminal-header">
              <span class="terminal-dot red"></span>
              <span class="terminal-dot yellow"></span>
              <span class="terminal-dot green"></span>
              <span class="terminal-title">ROBLOX // UNIVERSE 10762636904</span>
            </div>

            <div class="terminal-body">
              <div class="terminal-poster-wrap">
                <img src="/images/screenshots/scene_0.webp" alt="Cameraman Tower Defense Showcase" class="terminal-poster" width="768" height="432" loading="eager" />
                <div class="poster-overlay-tag">UPDATE 4 ACTIVE</div>
              </div>

              <div class="terminal-metrics-grid">
                <div class="metric-cell">
                  <span class="metric-label">CURRENT PLAYERS</span>
                  <span class="metric-val text-cyan">{livePlaying.toLocaleString()}</span>
                </div>
                <div class="metric-cell">
                  <span class="metric-label">TOTAL VISITS</span>
                  <span class="metric-val">{totalVisits.toLocaleString()}</span>
                </div>
                <div class="metric-cell">
                  <span class="metric-label">COMMUNITY RATING</span>
                  <span class="metric-val text-green">{ratingPercent}% Positive</span>
                </div>
                <div class="metric-cell">
                  <span class="metric-label">OFFICIAL CREATOR</span>
                  <span class="metric-val text-muted">Aligators Games</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- HOMEPAGE GAMEPLAY SHOWCASE VIDEO -->
  <section class="homepage-showcase-section" style="padding: 1.5rem 0 0.5rem;">
    <div class="container" style="max-width: 960px;">
      <VideoEmbed
        id="E6jfnsuMC2Y"
        title="The ULTIMATE Beginners GUIDE For Cameraman Tower Defense!"
        description="Comprehensive beginner guide and gameplay walkthrough for Cameraman Tower Defense."
        channel="MelloTD"
        uploadDate="2026-10-28"
        captionLabel="Gameplay walkthrough and beginner guide"
      />
    </div>
  </section>

  <!-- 广告位 1/3：首屏下方（hero + 视频之后，统计条之前）。
       300x250 是本矩阵填充率最稳的尺寸；放在这里是因为 hero 太高，
       再往上放会顶掉 H1 与 CTA，反而伤首屏转化。 -->
  <div class="container" style="max-width: 960px;">
    <AdSlot zone="banner-300x250" />
  </div>

  <!-- 4 STATS COUNTER BAR -->
  <section class="metrics-bar-section">
    <div class="container">
      <div class="stats-ribbon">
        <div class="ribbon-item">
          <span class="ribbon-num">{totalUnitsCount}</span>
          <span class="ribbon-lbl">INDEXED UNITS</span>
        </div>
        <div class="ribbon-item">
          <span class="ribbon-num">{activeCodesCount}</span>
          <span class="ribbon-lbl">ACTIVE PROMO CODES</span>
        </div>
        <div class="ribbon-item">
          <span class="ribbon-num">±10%</span>
          <span class="ribbon-lbl">FAIR TRADE CORRIDOR</span>
        </div>
        <div class="ribbon-item">
          <span class="ribbon-num">50 WAVES</span>
          <span class="ribbon-lbl">NIGHTMARE GAUNTLET</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CHANNELS CATEGORIZED GRIDS -->
  <main class="container page-content" style="padding-top: 3.5rem; padding-bottom: 4rem;">
    <!-- CATEGORIZED CHANNEL 1: VALUES -->
    <section class="channel-section" id="channel-values">
      <div class="channel-section-header">
        <div class="channel-title-group">
          <span class="channel-badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">P0 TRADING TOOL</span>
          <h2>Unit Values & Interactive Trade Calculator</h2>
        </div>
        <p class="channel-desc">{CHANNEL_SUMMARIES.values}</p>
      </div>

      <div class="cards-grid">
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src={CHANNEL_CARDS.values.image} alt={CHANNEL_CARDS.values.alt} loading="lazy" width="800" height="500" />
            <span class="card-tag">INTERACTIVE</span>
          </div>
          <div class="card-body">
            <h3><a href="/values/" class="stretched-link">Cameraman Tower Defense Trade Calculator & Values</a></h3>
            <p>Compute 4-slot trade equity, analyze Win/Fair/Lose profit margins, and inspect current demand benchmarks across all 39 units.</p>
            <div class="card-footer">
              <span class="card-action">Launch Calculator →</span>
              <span class="card-meta">Update 4 Index</span>
            </div>
          </div>
        </article>
      </div>

      <!-- Calculator Overview & Value Quick Reference -->
      <div class="calculator-intel-block">
        <div class="calculator-intel-header">
          <div class="calculator-intel-pill">
            <span class="intel-dot"></span>
            <span>VAULTED VALUES X & EQUITY MATRIX</span>
          </div>
          <h3>How the Cameraman Tower Defense Trade Calculator Works</h3>
          <p>
            The Cameraman Tower Defense trade calculator assesses offer equity by aggregating community-benchmarked point valuations across up to 4 trade slots per side, factoring in supply rarity and liquidity demand ratings from Vaulted Values.
          </p>
        </div>

        <div class="calculator-tier-grid">
          <div class="calc-status-card status-fair">
            <div class="status-badge">FAIR TRADE (F)</div>
            <div class="status-range">±10% Margin</div>
            <p>Balanced equity exchange where total point values remain within 10% parity. Recommended for standard roster upgrades.</p>
          </div>
          <div class="calc-status-card status-win">
            <div class="status-badge">WIN (W / BW)</div>
            <div class="status-range">+10% to +30%+ Margin</div>
            <p>Significant point surplus or favorable liquidity migration. Big Wins exceed +30% value surplus over incoming offers.</p>
          </div>
          <div class="calc-status-card status-lose">
            <div class="status-badge">LOSE (L / BL)</div>
            <div class="status-range">&lt; -10% Deficit</div>
            <p>Unfavorable trade with negative equity exceeding 10% deficit, or trading high-demand Godlies for illiquid lower tiers.</p>
          </div>
        </div>

        <div class="calculator-quick-actions">
          <a href="/values/#trade-calculator" class="calc-action-btn primary">
            <span>⚖️ Open 4-Slot Trade Calculator</span>
          </a>
          <a href="/values/#value-table" class="calc-action-btn secondary">
            <span>📋 Browse 39-Unit Value List</span>
          </a>
          <a href="/values/#fairness-methodology" class="calc-action-btn outline">
            <span>📐 Valuation Methodology</span>
          </a>
        </div>

        <div class="calculator-crosslink-bar">
          <span class="crosslink-label">TACTICAL WORKFLOW:</span>
          <span class="crosslink-items">
            Need summon coins? <a href="/codes/">Redeem Active Codes</a>
            <span class="sep">•</span>
            Live trading lobbies? <a href="/discord/">Aligators Games Discord</a>
            <span class="sep">•</span>
            Build solo deck? <a href="/how-to-solo-nightmare-mode/">Nightmare Mode Guide</a>
          </span>
        </div>
      </div>
    </section>

    <!-- CATEGORIZED CHANNEL 2: CODES -->
    <section class="channel-section" id="channel-codes" style="margin-top: 4rem;">
      <div class="channel-section-header">
        <div class="channel-title-group">
          <span class="channel-badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">P0 REWARDS</span>
          <h2>Promo Codes & Free Coin Entitlements</h2>
        </div>
        <p class="channel-desc">{CHANNEL_SUMMARIES.codes}</p>
      </div>

      <div class="cards-grid">
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src={CHANNEL_CARDS.codes.image} alt={CHANNEL_CARDS.codes.alt} loading="lazy" width="800" height="500" />
            <span class="card-tag">DAILY AUDITED</span>
          </div>
          <div class="card-body">
            <h3><a href="/codes/" class="stretched-link">Cameraman Tower Defense Codes (November 2026)</a></h3>
            <p>Verified working coin drops including <code>LStriderSpeaker</code>, <code>Battlepass</code>, and <code>UTCM</code> with the mandatory 3-win unlock step guide.</p>
            <div class="card-footer">
              <span class="card-action">Copy Working Codes →</span>
              <span class="card-meta">{activeCodesCount} Codes Active</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- 广告位 2/3：三个频道段之间的自然断点。
         用 160x300 而不是 160x600：首页没有侧栏，160x600 那种 600px 高的竖幅在手机上
         会吃掉整屏，而 160x300 桌面移动都放得下。160x600 留给有侧栏的页面（DualSidebar 自带）。
         同页尺寸不与位 1（300x250）和页尾（728x90 / 320x50）重复。 -->
    <div class="container" style="max-width: 960px;">
      <AdSlot zone="banner-160x300" />
    </div>

    <!-- CATEGORIZED CHANNEL 3: UNITS -->
    <section class="channel-section" id="channel-units" style="margin-top: 4rem;">
      <div class="channel-section-header">
        <div class="channel-title-group">
          <span class="channel-badge" style="background: rgba(129, 140, 248, 0.15); color: #818cf8; border: 1px solid rgba(129, 140, 248, 0.3);">P1 ROSTER</span>
          <h2>Units Database & Detailed Guides</h2>
        </div>
        <p class="channel-desc">{CHANNEL_SUMMARIES.units}</p>
      </div>

      <div class="cards-grid grid-3-cols">
        <!-- Units Index Hub Card -->
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src={CHANNEL_CARDS.units.image} alt={CHANNEL_CARDS.units.alt} loading="lazy" width="800" height="500" />
            <span class="card-tag">FULL ROSTER</span>
          </div>
          <div class="card-body">
            <h3><a href="/units/" class="stretched-link">Complete 39 Units Roster & Index</a></h3>
            <p>Explore all Godly, Mythic, Legendary, Epic, Rare, and Basic units with DPS, range, and unlock methods.</p>
            <div class="card-footer">
              <span class="card-action">Explore All 39 Units →</span>
            </div>
          </div>
        </article>

        <!-- UTCM Card -->
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src="/images/cards/card_utcm.webp" alt="Upgraded Titan Cameraman Guide" loading="lazy" width="800" height="500" />
            <span class="card-tag">GODLY CARRY</span>
          </div>
          <div class="card-body">
            <h3><a href="/units/upgraded-titan-cameraman/" class="stretched-link">Upgraded Titan Cameraman (UTCM) Guide</a></h3>
            <p>Endgame godly railgun carry stats, DPS scaling benchmarks, spin pity rates, and optimal placement loops.</p>
            <div class="card-footer">
              <span class="card-action">View Unit Dossier →</span>
            </div>
          </div>
        </article>

        <!-- Featured unit card -->
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src="/images/cards/card_chaos.webp" alt="Chaos Cameraman value and stats guide" loading="lazy" width="800" height="500" />
            <span class="card-tag">NEW PATCH</span>
          </div>
          <div class="card-body">
            <h3><a href="/units/chaos-cameraman/" class="stretched-link">Chaos Cameraman Guide</a></h3>
            <p>Newly introduced in the Halloween update. Full breakdown of screen radiation damage and Nightmare boss sweeps.</p>
            <div class="card-footer">
              <span class="card-action">View Unit Dossier →</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- CATEGORIZED CHANNEL 4: TIER LIST -->
    <section class="channel-section" id="channel-tier-list" style="margin-top: 4rem;">
      <div class="channel-section-header">
        <div class="channel-title-group">
          <span class="channel-badge" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3);">P1 META</span>
          <h2>Unit Meta Tier List & Rankings</h2>
        </div>
        <p class="channel-desc">{CHANNEL_SUMMARIES["tier-list"]}</p>
      </div>

      <div class="cards-grid">
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src={CHANNEL_CARDS["tier-list"].image} alt={CHANNEL_CARDS["tier-list"].alt} loading="lazy" width="800" height="500" />
            <span class="card-tag">UPDATE 4 META</span>
          </div>
          <div class="card-body">
            <h3><a href="/tier-list/" class="stretched-link">Cameraman Tower Defense Meta Tier List (Update 4)</a></h3>
            <p>Evaluates DPS-to-cost efficiency, boss shredding utility, and crowd control across S, A, B, C, and D tiers for all 39 units.</p>
            <div class="card-footer">
              <span class="card-action">View Tier List Rankings →</span>
              <span class="card-meta">Patch Update 4</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- CATEGORIZED CHANNEL 5: TACTICAL GUIDES -->
    <section class="channel-section" id="channel-guides" style="margin-top: 4rem;">
      <div class="channel-section-header">
        <div class="channel-title-group">
          <span class="channel-badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">P1/P2 GUIDES</span>
          <h2>Tactical Walkthroughs & Official Hubs</h2>
        </div>
        <p class="channel-desc">{CHANNEL_SUMMARIES.guides}</p>
      </div>

      <div class="cards-grid grid-3-cols">
        <!-- Nightmare Solo Guide Card -->
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src={CHANNEL_CARDS.guides.image} alt={CHANNEL_CARDS.guides.alt} loading="lazy" width="800" height="500" />
            <span class="card-tag">TACTICAL GUIDE</span>
          </div>
          <div class="card-body">
            <h3><a href="/how-to-solo-nightmare-mode/" class="stretched-link">How to Solo Nightmare Mode Guide</a></h3>
            <p>Complete 50-wave solo walkthrough on Desert map: early cash farming, Glitch Cameraman slow placement, and boss strategies.</p>
            <div class="card-footer">
              <span class="card-action">Read Solo Blueprint →</span>
            </div>
          </div>
        </article>

        <!-- Discord Hub Card -->
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src="/images/cards/card_discord.webp" alt="Official Discord & Trading Hub" loading="lazy" width="800" height="500" />
            <span class="card-tag">COMMUNITY HUB</span>
          </div>
          <div class="card-body">
            <h3><a href="/discord/" class="stretched-link">Official Discord & Trading Community Hub</a></h3>
            <p>Verified links to Aligators Games official Discord server, trade advertisement channels, developer giveaways, and moderation rules.</p>
            <div class="card-footer">
              <span class="card-action">Access Discord Coordinates →</span>
            </div>
          </div>
        </article>

        <!-- Shop & Economy Guide Card -->
        <article class="guide-card stretched-link-card">
          <div class="card-media">
            <img src="/images/cards/card_shop.webp" alt="In-Game Shop & Economy Guide" loading="lazy" width="800" height="500" />
            <span class="card-tag">ECONOMY GUIDE</span>
          </div>
          <div class="card-body">
            <h3><a href="/shop/" class="stretched-link">In-Game Shop, Crates & Gamepasses Guide</a></h3>
            <p>Comprehensive guide to coin summon crates, VIP gamepass multipliers, gem spending, and free-to-play economy optimization.</p>
            <div class="card-footer">
              <span class="card-action">Read Economy Guide →</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- IN-GAME SCREENSHOT GALLERY -->
    <section class="gallery-section" style="margin-top: 5rem;">
      <div class="channel-section-header">
        <div class="channel-title-group">
          <span class="channel-badge" style="background: rgba(148, 163, 184, 0.15); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3);">MEDIA SHOWCASE</span>
          <h2>Official Game Field Action & Maps</h2>
        </div>
        <p class="channel-desc">High-resolution combat screenshots from Cameraman Tower Defense live servers.</p>
      </div>

      <div class="screenshots-grid">
        {OFFICIAL_SCREENSHOTS.map((s, idx) => (
          <div class="screenshot-item">
