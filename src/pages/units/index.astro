---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import { siteConfig } from "../../config/site.config";
import valuesData from "../../data/values.json";

const tocHeadings = [
  { depth: 2, slug: "roster-overview", text: "Units Roster Overview" },
  { depth: 2, slug: "godly-units", text: "Godly Rarity Units" },
  { depth: 2, slug: "mythic-units", text: "Mythic Rarity Units" },
  { depth: 2, slug: "legendary-units", text: "Legendary Rarity Units" },
  { depth: 2, slug: "epic-units", text: "Epic & Support Units" },
  { depth: 2, slug: "rare-basic-units", text: "Rare & Starter Units" },
  { depth: 2, slug: "evidence-dossier", text: "Verified Index Ledger" },
];

const totalCount = valuesData.length;
const godlyList = valuesData.filter(u => u.rarity === 'Godly');
const mythicList = valuesData.filter(u => u.rarity === 'Mythic');
const legendaryList = valuesData.filter(u => u.rarity === 'Legendary');
const epicList = valuesData.filter(u => u.rarity === 'Epic');
const otherList = valuesData.filter(u => u.rarity === 'Rare' || u.rarity === 'Basic');

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Cameraman Tower Defense Units Database",
    "description": "Comprehensive roster and value directory for all 39 units in Cameraman Tower Defense on Roblox.",
    "url": `${siteConfig.siteUrl}/units/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Units", "item": `${siteConfig.siteUrl}/units/` },
    ],
  },
];
---

<BaseLayout
  title="Cameraman Tower Defense Units Roster & Stats"
  description="Complete Cameraman Tower Defense units database. Compare trade value, demand and tier placement across all 39 Godly, Mythic, Legendary and Epic units."
  canonical="/units/"
  jsonLd={jsonLd}
>
  <div class="container article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">Units</span>
    </nav>

    <header class="guide-header">
      <div class="guide-badges">
        <span class="badge" style="background: rgba(129, 140, 248, 0.15); color: #818cf8; border: 1px solid rgba(129, 140, 248, 0.3);">P1 ROSTER</span>
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">{totalCount} UNITS INDEXED</span>
        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">UPDATE 4 EXPANSION</span>
      </div>
      <h1>Cameraman Tower Defense Units Database (39 Units)</h1>
      <p class="guide-lead">
        Browse the verified roster of all 38 playable units in Roblox Cameraman Tower Defense. Compare DPS scaling, attack range, trading values, and summon mechanics.
      </p>
    </header>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main">
        <!-- Mobile Table of Contents -->
        <details class="mobile-toc">
          <summary>
            <span>ON THIS PAGE (TABLE OF CONTENTS)</span>
            <span>▾</span>
          </summary>
          <div class="mobile-toc-inner">
            <ol class="toc-step-list">
              {tocHeadings.map((item, idx) => (
                <li class={`toc-step-item depth-${item.depth}`}>
                  <a href={`#${item.slug}`} class="toc-step-link">
                    <span class="toc-step-num">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="toc-step-title">{item.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>

        <!-- 广告位 1/2：H1 之后、正文之前。468x60 在窄屏（<520px）由 AdSlot 的
             scoped CSS 整槽隐藏，避免裁切；页尾第二位由 BaseLayout 统一挂载。
             索引页只放 2 位——承接流量的深度页才铺满 3 位，索引页堆满反而稀释可见率。 -->
        <AdSlot zone="banner-468x60" />

        <!-- SECTION 1: OVERVIEW -->
        <section id="roster-overview">
          <h2>Units Roster Overview</h2>
          <p>
            While early launch wikis only listed 31 units, the in-game unit index expanded to <strong>39 units</strong> following the Spider update and Halloween 2026 event. This comprehensive directory covers all active summons, event crates, and starter units.
          </p>
        </section>

        <VideoEmbed
          id="7QBiS599euI"
          title="Cameraman Tower Defense Value List: What Every Unit Is Worth After Update 4"
          description="Complete unit roster values and trading tier overview for Cameraman Tower Defense."
          channel="Vaulted Values X"
          uploadDate="2026-10-26"
          captionLabel="Unit roster valuation overview"
        />

        <!-- SECTION 2: GODLY UNITS -->
        <section id="godly-units" style="margin-top: 3rem;">
          <div class="section-title-wrap">
            <h2>Godly Rarity Units (Apex Titans)</h2>
            <p class="section-desc">The rarest and most potent carries in the game, commanding the highest trading valuations.</p>
          </div>
          <div class="unit-cards-grid">
            {godlyList.map((u) => (
              <div class="unit-profile-card">
                <div class="u-thumb-box">
                  <img src={`/images/units/${u.id}.webp`} alt={u.name} loading="lazy" width="800" height="500" />
                  <span class="u-rarity-pill godly">GODLY</span>
                </div>
                <div class="u-content-box">
                  <h3><a href={`/units/${u.id}/`}>{u.name}</a></h3>
                  <div class="u-meta-row">
                    <span><strong>DPS:</strong> Not published</span>
                    <span><strong>Range:</strong> Not published</span>
                    <span><strong>Tier:</strong> {u.tier}</span>
                  </div>
                  <p>{u.description}</p>
                  <div class="u-card-bottom">
                    <span class="u-val">Value: {u.value.toLocaleString()} pts</span>
                    <a href={`/units/${u.id}/`} class="u-link">View Stats →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 3: MYTHIC UNITS -->
        <section id="mythic-units" style="margin-top: 3.5rem;">
          <div class="section-title-wrap">
            <h2>Mythic Rarity Units (Core Carry Specialists)</h2>
            <p class="section-desc">High-tier specialist units designed for multi-lane damage and boss melting.</p>
          </div>
          <div class="unit-cards-grid">
            {mythicList.map((u) => (
              <div class="unit-profile-card">
                <div class="u-thumb-box">
                  <img src={`/images/units/${u.id}.webp`} alt={u.name} loading="lazy" width="800" height="500" />
                  <span class="u-rarity-pill mythic">MYTHIC</span>
                </div>
                <div class="u-content-box">
                  <h3><a href={`/units/${u.id}/`}>{u.name}</a></h3>
                  <div class="u-meta-row">
                    <span><strong>DPS:</strong> Not published</span>
                    <span><strong>Range:</strong> Not published</span>
                    <span><strong>Tier:</strong> {u.tier}</span>
                  </div>
                  <p>{u.description}</p>
                  <div class="u-card-bottom">
                    <span class="u-val">Value: {u.value.toLocaleString()} pts</span>
                    <a href={`/units/${u.id}/`} class="u-link">View Stats →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 4: LEGENDARY UNITS -->
        <section id="legendary-units" style="margin-top: 3.5rem;">
          <div class="section-title-wrap">
            <h2>Legendary Rarity Units (Essential Utility & Crowd Control)</h2>
            <p class="section-desc">Workhorse units providing automated turrets, slowing fields, and airborne support.</p>
          </div>
          <div class="unit-cards-grid">
            {legendaryList.map((u) => (
              <div class="unit-profile-card">
                <div class="u-thumb-box">
                  <img src={`/images/units/${u.id}.webp`} alt={u.name} loading="lazy" width="800" height="500" />
                  <span class="u-rarity-pill legendary">LEGENDARY</span>
                </div>
                <div class="u-content-box">
                  <h3><a href={`/units/${u.id}/`}>{u.name}</a></h3>
                  <div class="u-meta-row">
                    <span><strong>DPS:</strong> Not published</span>
                    <span><strong>Range:</strong> Not published</span>
                    <span><strong>Tier:</strong> {u.tier}</span>
                  </div>
                  <p>{u.description}</p>
                  <div class="u-card-bottom">
                    <span class="u-val">Value: {u.value.toLocaleString()} pts</span>
                    <a href={`/units/${u.id}/`} class="u-link">View Stats →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 5: EPIC & SUPPORT -->
        <section id="epic-units" style="margin-top: 3.5rem;">
          <div class="section-title-wrap">
            <h2>Epic Rarity Units (Economy Farms & Base Support)</h2>
            <p class="section-desc">Foundational cash generation and repair units required to afford expensive late-game titans.</p>
          </div>
          <div class="unit-cards-grid">
            {epicList.map((u) => (
              <div class="unit-profile-card">
                <div class="u-thumb-box">
                  <img src={`/images/units/${u.id}.webp`} alt={u.name} loading="lazy" width="800" height="500" />
                  <span class="u-rarity-pill epic">EPIC</span>
                </div>
                <div class="u-content-box">
                  <h3><a href={`/units/${u.id}/`}>{u.name}</a></h3>
                  <div class="u-meta-row">
                    <span><strong>DPS:</strong> Not published</span>
                    <span><strong>Range:</strong> Not published</span>
                    <span><strong>Tier:</strong> {u.tier}</span>
                  </div>
                  <p>{u.description}</p>
                  <div class="u-card-bottom">
                    <span class="u-val">Value: {u.value.toLocaleString()} pts</span>
                    <a href={`/units/${u.id}/`} class="u-link">View Stats →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 6: RARE & BASIC -->
        <section id="rare-basic-units" style="margin-top: 3.5rem;">
          <div class="section-title-wrap">
            <h2>Rare & Basic Rarity Units (Early Game Starters)</h2>
            <p class="section-desc">Cost-efficient starters and summon fodder used to stop wave 1-10 fast rush toilets.</p>
          </div>
          <div class="unit-cards-grid">
            {otherList.map((u) => (
              <div class="unit-profile-card">
                <div class="u-thumb-box">
                  <img src={`/images/units/${u.id}.webp`} alt={u.name} loading="lazy" width="800" height="500" />
                  <span class={`u-rarity-pill ${u.rarity.toLowerCase()}`}>{u.rarity.toUpperCase()}</span>
                </div>
                <div class="u-content-box">
                  <h3><a href={`/units/${u.id}/`}>{u.name}</a></h3>
                  <div class="u-meta-row">
                    <span><strong>DPS:</strong> Not published</span>
                    <span><strong>Range:</strong> Not published</span>
                    <span><strong>Tier:</strong> {u.tier}</span>
                  </div>
                  <p>{u.description}</p>
                  <div class="u-card-bottom">
                    <span class="u-val">Value: {u.value.toLocaleString()} pts</span>
                    <a href={`/units/${u.id}/`} class="u-link">View Stats →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 7: EVIDENCE DOSSIER -->
        <section id="evidence-dossier" style="margin-top: 3.5rem;">
          <h2>Verified Index Ledger & Dossier</h2>
          <div class="evidence-box">
            <div class="evidence-header">
              <span class="evidence-shield">🛡️ IN-GAME INDEX VALIDATION</span>
              <span class="evidence-status">INDEXED: 39 UNITS</span>
            </div>
            <div class="evidence-body">
              <p><strong>Audited Game:</strong> Roblox Universe ID <code>10762636904</code> (Cameraman Tower Defense by Aligators Games).</p>
              <p><strong>Verification Standard:</strong> Empirical audit confirming 38 total distinct units (excluding duplicate non-playable NPCs).</p>
              <blockquote>
                <em>"Early community wikis reporting 31 units overlooked the 7 additions from the Spider Crate and Halloween 2026 event rotation (Pumpkin Farmer, Headless TV Man, Werewolf Speakerman, Clown Speakerman, Camera Repair Drone)."</em>
              </blockquote>
            </div>
          </div>
        </section>
      </article>

      <!-- Sidebar -->
      <DualSidebar
        tocHeadings={tocHeadings}
        currentUrl="/units/"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .unit-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .unit-profile-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .unit-profile-card:hover {
    transform: translateY(-3px);
    border-color: rgba(56, 189, 248, 0.4);
  }
  .u-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #090e18;
  }
  .u-thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .u-rarity-pill {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
  }
  .u-rarity-pill.godly { background: rgba(56, 189, 248, 0.9); color: #080c14; }
  .u-rarity-pill.mythic { background: rgba(244, 63, 94, 0.9); color: #fff; }
  .u-rarity-pill.legendary { background: rgba(234, 179, 8, 0.9); color: #080c14; }
  .u-rarity-pill.epic { background: rgba(168, 85, 247, 0.9); color: #fff; }
  .u-rarity-pill.rare { background: rgba(59, 130, 246, 0.9); color: #fff; }
  .u-rarity-pill.basic { background: rgba(148, 163, 184, 0.9); color: #080c14; }

  .u-content-box {
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .u-content-box h3 {
    margin: 0 0 0.4rem 0;
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .u-content-box h3 a {
    color: #f8fafc;
    text-decoration: none;
  }
  .u-content-box h3 a:hover {
    color: #38bdf8;
  }
  .u-meta-row {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono, monospace);
  }
  .u-meta-row strong {
    color: #cbd5e1;
  }
  .u-content-box p {
    color: #94a3b8;
    font-size: 0.85rem;
    line-height: 1.45;
    margin: 0 0 1rem 0;
    flex: 1;
  }
  .u-card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #1e293b;
    padding-top: 0.6rem;
    font-size: 0.8rem;
  }
  .u-val {
    color: #38bdf8;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
  }
  .u-link {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 600;
  }
  .u-link:hover {
    color: #38bdf8;
  }

  /* Evidence Box */
  .evidence-box {
    background: #0b1120;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 8px;
    padding: 1.25rem;
    margin-top: 1rem;
  }
  .evidence-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .evidence-shield {
    color: #38bdf8;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  .evidence-status {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .evidence-body p {
    font-size: 0.875rem;
    color: #cbd5e1;
    margin: 0.4rem 0;
  }
  .evidence-body code {
    background: #1e293b;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: #38bdf8;
  }
  .evidence-body blockquote {
    border-left: 3px solid #38bdf8;
    margin: 0.8rem 0 0 0;
    padding-left: 0.8rem;
    color: #94a3b8;
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
