---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";
import valuesData from "../../data/values.json";
import unitStatsData from "../../data/unit-stats.json";
import unitPriceHistoryData from "../../data/unit-price-history.json";
import unitEditorialData from "../../data/unit-editorial.json";
import unitAcquisitionData from "../../data/unit-acquisition.json";

export async function getStaticPaths() {
  return valuesData.map((unit) => ({
    params: { slug: unit.id },
    props: { unit },
  }));
}

const { unit } = Astro.props;
const unitId = unit.id;
const editorial = unitEditorialData[unitId] || {};

// Dates on this page are read off the data, never typed by hand. The page used to
// print a hardcoded "list dated 2026-10-25" while the hero above it showed a
// re-synced value from a newer list, so every unit page carried two dates and two
// prices for the same number.
const currentValuesDate = unit.source?.retrievedAt ?? "unknown";
const historyListDate = unitPriceHistoryData.source.listDate;

// Dataset Lookups
const statVerified = unitStatsData.verified[unitId] || null;
const statSingleSource = unitStatsData.singleSource[unitId] || null;
const statEntry = statVerified || statSingleSource || null;
const statVerificationType = statVerified
  ? "Two independent card readings agree"
  : statSingleSource
  ? "Single-source report"
  : null;

const priceHistory = unitPriceHistoryData.history[unitId] || null;

const TRADE_UNIT_MAP: Record<string, number[]> = {
  "titan-cinemaman": [0, 6],
  "ninja-cameraman": [0],
  "upgraded-videotapper-prototype": [1, 3],
  "pumpkin-farmer": [1, 2, 4],
  "scientist-cameraman": [2, 4],
  "tv-woman": [3, 6],
  "upgraded-titan-speakerman": [4],
  "upgraded-titan-cameraman": [5],
  "large-scientist-cameraman": [5],
  "headless-tv-man": [6],
  "executioner-tv-man": [7],
  "engineer-cameraman": [7],
};

const tradeIndices = TRADE_UNIT_MAP[unitId] || [];
const sampleTrades = tradeIndices.map((i) => unitPriceHistoryData.sampleTrades[i]).filter(Boolean);

const hasRange = statEntry && statEntry.range !== null;
const isSpawner = statEntry && statEntry.note && statEntry.note.includes("Spawner");
const hasPlacement = hasRange || isSpawner;

const hasHistory = !!priceHistory;
const hasStats = !!statEntry;
const hasTrades = sampleTrades.length > 0;
// 获得途径（来源：RoboLibrary "Crate Odds Behind These Units"，与 stats 同源）
const acqUnit = (unitAcquisitionData.units as Record<string, any>)[unitId];
const acqCrateKey = acqUnit?.crate || (unitAcquisitionData.byRarity as Record<string,string>)[unit.rarity];
const acqCrate = acqCrateKey ? (unitAcquisitionData.crates as Record<string, any>)[acqCrateKey] : null;
const acquisition = acqCrate ? {
  crateName: acqCrate.name as string,
  cost: acqCrate.cost as string,
  crateOdds: acqCrate.odds as string,
  unitOdds: (acqUnit?.odds as string) || null,
  note: (acqCrate.note as string) || null,
  extra: (acqUnit?.extra as string) || null,
} : null;
const hasAcquisition = !!acquisition;

// The hero card and the history section sit on the same screen, so a reader
// comparing "525 pts" against "1,900 on the October 25 list" needs to see which
// number is current. The date comes from the data, not from this template.
const valueAsOf = unit.source?.retrievedAt
  ? new Date(unit.source.retrievedAt + "T00:00:00Z")
      .toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
  : null;

// SERP TDH optimization (Title <= 60, Meta Description <= 160, H1 <= 50)
const cleanName = unit.name.replace(/\s*\([^)]*\)/g, "").trim();
const pageTitle = cleanName.length > 25 ? `${cleanName} Stats & Value` : `${cleanName} Stats & Trade Value`;
const metaDesc = `${cleanName} trade value, demand score and tier placement in Cameraman Tower Defense, sourced from the dated community value list.`;
const pageH1 = cleanName.length > 25 ? `${cleanName} Stats & Value` : `${cleanName} Stats & Value Guide`;

// Dynamic Table of Contents — strictly omit sections without data
const tocHeadings = [
  { depth: 2, slug: "quick-answer", text: "Quick Answer" },
  ...(hasAcquisition ? [{ depth: 2, slug: "how-to-get", text: "How to Get It" }] : []),
  ...(hasHistory ? [{ depth: 2, slug: "value-history", text: "Value & Price History" }] : []),
  ...(hasStats ? [{ depth: 2, slug: "combat-stats", text: "Combat Stats" }] : []),
  ...(hasTrades ? [{ depth: 2, slug: "how-to-trade", text: "How to Trade It" }] : []),
  ...(hasPlacement ? [{ depth: 2, slug: "placement-notes", text: "Placement Notes" }] : []),
  { depth: 2, slug: "what-we-dont-know", text: "What We Don't Know" },
  { depth: 2, slug: "source-ledger", text: "Source Ledger" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemPage",
    name: `${unit.name} - Cameraman Tower Defense Unit Guide`,
    description: metaDesc,
    url: `${siteConfig.siteUrl}/units/${unit.id}/`,
    image: `${siteConfig.siteUrl}/images/units/${unit.id}.webp`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
      { "@type": "ListItem", position: 2, name: "Units", item: `${siteConfig.siteUrl}/units/` },
      { "@type": "ListItem", position: 3, name: unit.name, item: `${siteConfig.siteUrl}/units/${unit.id}/` },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={metaDesc}
  canonical={`/units/${unit.id}/`}
  jsonLd={jsonLd}
>
  <div class="container article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href="/units/">Units</a>
      <span class="separator">/</span>
      <span class="current">{unit.name}</span>
    </nav>

    <header class="guide-header">
      <div class="guide-badges">
        <span class={`rarity-badge tag-${unit.rarity.toLowerCase()}`}>{unit.rarity.toUpperCase()}</span>
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">TIER {unit.tier}</span>
        <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3);">{unit.category.toUpperCase()}</span>
      </div>
      <h1>{pageH1}</h1>
      <p class="guide-lead">
        Dated community trade value, demand score, and gameplay guide for <strong>{unit.name}</strong> in Roblox Cameraman Tower Defense.
      </p>
    </header>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main">
        <!-- Mobile Table of Contents -->
        <details class="mobile-toc">
          <summary>
            <span>ON THIS PAGE (TABLE OF CONTENTS)</span>
            <span>▾</span>
          </summary>
          <div class="mobile-toc-inner">
            <ol class="toc-step-list">
              {tocHeadings.map((item, idx) => (
                <li class={`toc-step-item depth-${item.depth}`}>
                  <a href={`#${item.slug}`} class="toc-step-link">
                    <span class="toc-step-num">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="toc-step-title">{item.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>

        <!-- Unit Hero Card -->
        <div class="unit-hero-banner">
          <div class="banner-media">
            <img src={`/images/units/${unit.id}.webp`} alt={unit.name} loading="eager" width="800" height="500" />
          </div>
          <div class="banner-stats">
            <div class="stat-box">
              <span class="lbl">TRADE VALUE{valueAsOf ? ` · ${valueAsOf}` : ""}</span>
              <span class="val cyan">{unit.value > 0 ? <>{unit.value.toLocaleString()} <small>pts</small></> : <small>No published value</small>}</span>
            </div>
            <div class="stat-box">
              <span class="lbl">BASE DPS</span>
              <span class="val">{statEntry && statEntry.maxDps !== null ? statEntry.maxDps.toLocaleString() : <small>Not in any published reading</small>}</span>
            </div>
            <div class="stat-box">
              <span class="lbl">ATTACK RANGE</span>
              <span class="val">{statEntry && statEntry.range !== null ? statEntry.range : <small>Not in any published reading</small>}</span>
            </div>
            <div class="stat-box">
              <span class="lbl">DEMAND RATING</span>
              <span class="val">{unit.demand > 0 ? `${unit.demand} / 10` : <small>Not published</small>}</span>
            </div>
          </div>
        </div>

        <!-- 广告位 1/3：英雄卡之后、正文之前。
             39 个单位页是本站的 SEO 主力，每页结构相同 → 同一尺寸跨页复用，
             靠"每页同一位置"攒曝光样本，这是 160x300 那类尺寸能验出 CPM 的前提。 -->
        <AdSlot zone="banner-300x250" />

        <!-- SECTION 1: QUICK ANSWER -->
        <section id="quick-answer" class="guide-section" style="margin-top: 2.5rem;">
          <h2>Quick Answer</h2>
          <div class="quick-answer-card">
            <p class="quick-answer-text">{editorial.quickAnswer}</p>
          </div>
          {!hasHistory && !hasStats && editorial.noDataDeepDive && (
            <div class="no-data-analysis" style="margin-top: 1.25rem;">
              {editorial.noDataDeepDive.split('\n\n').map((p) => (
                <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin-bottom: 0.8rem;">{p}</p>
              ))}
            </div>
          )}
        </section>

        {hasAcquisition && (
          <section id="how-to-get" class="guide-section" style="margin-top: 3.5rem;">
            <h2>How to Get It</h2>
            <p class="section-lead">
              <strong>{acquisition.crateName}</strong> — {acquisition.cost}.
              {acquisition.unitOdds
                ? <>Drop chance for {unit.name}: <strong>{acquisition.unitOdds}</strong>.</>
                : <>{acquisition.crateOdds}.</>}
            </p>
            {acquisition.extra && (
              <p class="section-subtext" style="margin-top: 0.8rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {acquisition.extra}
              </p>
            )}
            {acquisition.note && (
              <p class="section-subtext" style="margin-top: 0.8rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {acquisition.note}
              </p>
            )}
            <div class="source-citation" style="margin-top: 1rem; font-size: 0.82rem; color: #64748b;">
              Crate odds: <a href="https://robolibrary.org/wikis/cameraman-tower-defense/units" target="_blank" rel="noopener">RoboLibrary</a>, checked 2026-10-11.
            </div>
          </section>
        )}

        <!-- SECTION 2: VALUE & PRICE HISTORY (Only if hasHistory) -->
        {hasHistory && (
          <section id="value-history" class="guide-section" style="margin-top: 3.5rem;">
            <h2>Value & Price History</h2>
            <p class="section-lead">{editorial.historyStory}</p>
            {editorial.timeline && editorial.timeline.length > 0 && (
              <div class="timeline-container">
                <h3 class="timeline-title">Historical Price Benchmarks</h3>
                <div class="timeline-grid">
                  {editorial.timeline.map((step, idx) => (
                    <div class="timeline-step">
                      <span class="step-num">0{idx + 1}</span>
                      <span class="step-label">{step.label}</span>
                      <span class="step-val">{step.value}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {editorial.marketAnalysis && (
              <p class="section-subtext" style="margin-top: 1.2rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.marketAnalysis}
              </p>
            )}
            {!hasStats && editorial.metaSynergy && (
              <p class="section-subtext" style="margin-top: 0.8rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.metaSynergy}
              </p>
            )}
            {!hasStats && editorial.tacticalTiming && (
              <p class="section-subtext" style="margin-top: 0.8rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.tacticalTiming}
              </p>
            )}
            <div class="source-citation">
              <span>Source: Vaulted Values X, live list read {currentValuesDate}. Timeline benchmarks from the list dated {historyListDate}.</span>
            </div>
          </section>
        )}

        <!-- SECTION 3: COMBAT STATS (Only if hasStats) -->
        {hasStats && (
          <section id="combat-stats" class="guide-section" style="margin-top: 3.5rem;">
            <h2>Combat Stats</h2>
            <div class="stat-evidence-badge">
              <span class="badge-dot">●</span>
              <span>Evidence Standard: {statVerificationType}</span>
            </div>
            <div class="table-responsive">
              <div class="table-scroll">
                <table class="specs-table">
                  <tbody>
                    <tr>
                      <th>Placement Cost</th>
                      <td>{statEntry.placeCost !== null ? `$${statEntry.placeCost}` : 'Not in any published reading'}</td>
                      <th>Maximum DPS</th>
                      <td>{statEntry.maxDps !== null ? statEntry.maxDps.toLocaleString() : 'Not in any published reading'}</td>
                    </tr>
                    <tr>
                      <th>Attack Range</th>
                      <td>{statEntry.range !== null ? statEntry.range : 'Not in any published reading'}</td>
                      <th>Card Reading Note</th>
                      <td>{statEntry.note || 'None recorded'}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            {editorial.combatAnalysis && (
              <p class="section-subtext" style="margin-top: 1.2rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.combatAnalysis}
              </p>
            )}
            {editorial.metaSynergy && (
              <p class="section-subtext" style="margin-top: 0.8rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.metaSynergy}
              </p>
            )}
            {editorial.tacticalTiming && (
              <p class="section-subtext" style="margin-top: 0.8rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.tacticalTiming}
              </p>
            )}
            <div class="source-citation">
              <span>Source: RoboLibrary, reading dated 2026-10-11</span>
            </div>
          </section>
        )}

        <!-- SECTION 4: HOW TO TRADE IT (Only if hasTrades) -->
        {hasTrades && (
          <section id="how-to-trade" class="guide-section" style="margin-top: 3.5rem;">
            <h2>How to Trade It</h2>
            <p class="section-lead">
              Community trade logs record documented peer-to-peer exchanges involving {unit.name} on dated list values:
            </p>
            <div class="trades-grid">
              {sampleTrades.map((t) => (
                <div class="trade-card">
                  <div class="trade-header">
                    <span class="trade-label">Documented Trade</span>
                    <span class="trade-verdict">{t.verdict}</span>
                  </div>
                  <p class="trade-pairing"><strong>Trade:</strong> {t.trade}</p>
                  <p class="trade-math"><strong>Math:</strong> {t.math}</p>
                </div>
              ))}
            </div>
            {editorial.tradeAdvice && (
              <p class="section-subtext" style="margin-top: 1.2rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.tradeAdvice}
              </p>
            )}
          </section>
        )}

        <!-- SECTION 5: PLACEMENT NOTES (Only if hasPlacement) -->
        {hasPlacement && (
          <section id="placement-notes" class="guide-section" style="margin-top: 3.5rem;">
            <h2>Placement Notes</h2>
            <div class="placement-box">
              <p style="margin: 0; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {editorial.placementGuide}
              </p>
            </div>
          </section>
        )}

        <!-- 广告位 2/3 在侧栏：DualSidebar 自带一个 sticky 160x600。
             这里不再插第二个 160x600 —— 同页同尺寸重复贴脸是明令禁止的，
             而且 39 个页面结构一致，重复会被放大 39 倍。 -->

        <!-- SECTION 6: WHAT WE DON'T KNOW (All units) -->
        <section id="what-we-dont-know" class="guide-section" style="margin-top: 3.5rem;">
          <h2>What We Don't Know</h2>
          <p class="section-lead">
            To maintain strict data integrity, our encyclopedia documents what is currently unmeasured for {unit.name}:
          </p>
          <ul class="unknowns-list">
            {editorial.unknowns && editorial.unknowns.map((unk) => (
              <li>{unk}</li>
            ))}
          </ul>
          <p class="dev-disclosure">
            Aligators Games does not publish official balance patches, stat cards, or damage formulas in public patch notes.
          </p>
        </section>

        <!-- SECTION 7: SOURCE LEDGER (All units) -->
        <section id="source-ledger" class="guide-section" style="margin-top: 3.5rem;">
          <h2>Source Ledger & Attribution</h2>
          <div class="evidence-box">
            <div class="evidence-header">
              <span class="evidence-shield">DATED SOURCE RECORD</span>
              <span class="evidence-status">LAST UPDATED: {currentValuesDate}</span>
            </div>
            <div class="evidence-body">
              <p><strong>Primary Valuation Anchor:</strong> Vaulted Values X live list, read {currentValuesDate}. Historical benchmarks in the timeline come from the {historyListDate} list (Video ID: {unitPriceHistoryData.source.videoId}).</p>
              {hasStats ? (
                <p><strong>Combat Stat Reference:</strong> RoboLibrary community stat cards, reading dated {unitStatsData.source.checkedAt} ({statVerificationType}).</p>
              ) : (
                <p><strong>Combat Stat Reference:</strong> Aligators Games does not publish unit stats, and this unit has not appeared in a graded community reading.</p>
              )}
              <p><strong>Valuation Scope:</strong> Trade points between units on a player-to-player basis, not developer gem prices. Commons, uncommons, and rares carry no trade points on community lists.</p>
            </div>
          </div>
        </section>
      </article>

      <!-- Sidebar -->
      <DualSidebar
        tocHeadings={tocHeadings}
        currentUrl={`/units/${unit.id}/`}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .unit-hero-banner {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    overflow: hidden;
    margin-top: 1.5rem;
  }
  .banner-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #090e18;
  }
  .banner-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #1e293b;
  }
  @media (max-width: 640px) {
    .banner-stats { grid-template-columns: repeat(2, 1fr); }
  }
  .stat-box {
    background: #0f172a;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-box .lbl {
    font-size: 0.7rem;
    color: #64748b;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.05em;
  }
  .stat-box .val {
    font-size: 1.25rem;
    font-weight: 700;
    color: #f8fafc;
    font-family: var(--font-mono, monospace);
  }
  .stat-box .val.cyan { color: #38bdf8; }
  .stat-box .val small { font-size: 0.8rem; color: #64748b; font-weight: 400; }

  .quick-answer-card {
    background: rgba(56, 189, 248, 0.06);
    border-left: 4px solid #38bdf8;
    border-radius: 0 8px 8px 0;
    padding: 1.25rem;
    margin-top: 1rem;
  }
  .quick-answer-text {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 500;
  }

  .timeline-container {
    background: #090e18;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 1.25rem;
    margin-top: 1.25rem;
  }
  .timeline-title {
    margin: 0 0 1rem 0;
    font-size: 0.85rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
  }
  .timeline-step {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .step-num {
    font-size: 0.7rem;
    color: #38bdf8;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
  }
  .step-label {
    font-size: 0.75rem;
    color: #94a3b8;
  }
  .step-val {
    font-size: 1rem;
    font-weight: 700;
    color: #f1f5f9;
    font-family: var(--font-mono, monospace);
  }

  .stat-evidence-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }
  .badge-dot { font-size: 0.6rem; color: #38bdf8; }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  .specs-table th {
    background: #090e18;
    color: #94a3b8;
    text-align: left;
    padding: 0.75rem 1rem;
    border: 1px solid #1e293b;
    width: 25%;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .specs-table td {
    padding: 0.75rem 1rem;
    border: 1px solid #1e293b;
    color: #cbd5e1;
    width: 25%;
  }

  .trades-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  .trade-card {
    background: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }
  .trade-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .trade-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono, monospace);
  }
  .trade-verdict {
