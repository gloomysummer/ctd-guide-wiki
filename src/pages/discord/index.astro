---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DualSidebar from "../../components/DualSidebar.astro";
import AdSlot from "../../components/AdSlot.astro";
import { siteConfig } from "../../config/site.config";

const tocHeadings = [
  { depth: 2, slug: "discord-overview", text: "Aligators Games Discord Overview" },
  { depth: 2, slug: "trading-channels", text: "Community Trading Channels" },
  { depth: 2, slug: "trade-verification-rules", text: "Scam Prevention & Trade Rules" },
  { depth: 2, slug: "developer-announcements", text: "Patch Notes & Code Giveaways" },
  { depth: 2, slug: "ecosystem-links", text: "Community Hub Progression" },
  { depth: 2, slug: "evidence-dossier", text: "Official Coordinates Ledger" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": "Cameraman Tower Defense Discord & Community Hub",
    "description": "Official community coordinates and trading hub rules for Cameraman Tower Defense on Roblox.",
    "url": `${siteConfig.siteUrl}/discord/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Discord", "item": `${siteConfig.siteUrl}/discord/` },
    ],
  },
];
---

<BaseLayout
  title="Cameraman Tower Defense Discord & Community Hub"
  description="Official Cameraman Tower Defense Discord guide. Join the Aligators Games community for trade channels, patch notes, giveaways, and developer announcements."
  canonical="/discord/"
  jsonLd={jsonLd}
>
  <div class="container article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">Discord Hub</span>
    </nav>

    <header class="guide-header">
      <div class="guide-badges">
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">P2 COMMUNITY HUB</span>
        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">VERIFIED CHANNELS</span>
      </div>
      <h1>Official Discord & Community Hub</h1>
      <p class="guide-lead">
        Find verified server links, official trading advertisement etiquette, developer giveaway schedules, and moderation guidelines for Roblox Cameraman Tower Defense.
      </p>
    </header>

    <div class="article-layout has-dual-sidebar">
      <article class="article-main">
        <!-- Mobile Table of Contents -->
        <details class="mobile-toc">
          <summary>
            <span>ON THIS PAGE (TABLE OF CONTENTS)</span>
            <span>▾</span>
          </summary>
          <div class="mobile-toc-inner">
            <ol class="toc-step-list">
              {tocHeadings.map((item, idx) => (
                <li class={`toc-step-item depth-${item.depth}`}>
                  <a href={`#${item.slug}`} class="toc-step-link">
                    <span class="toc-step-num">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="toc-step-title">{item.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>

        <!-- Discord Hero Card -->
        <div class="hub-hero-card">
          <div class="hub-card-left">
            <span class="hub-platform-tag">OFFICIAL ROBLOX GROUP & DISCORD</span>
            <h2>Aligators Games Community Server</h2>
            <p>
              Connect with over 150,000 active players, track developer sneak peeks for upcoming Titan updates, and trade Godly units directly in audited exchange lounges.
            </p>
            <div class="hub-cta-row">
              <a href="https://www.roblox.com/groups/1111394813/Aligators-Games" target="_blank" rel="noopener" class="btn btn-primary">
                Join Aligators Games Group →
              </a>
              <a href="/values/" class="btn btn-outline">
                Open the Trade Calculator →
              </a>
            </div>
          </div>
          <div class="hub-card-right">
            <div class="quick-meta-box">
              <div class="meta-item">
                <span class="meta-lbl">DEVELOPERS</span>
                <span class="meta-val">aibat303e & iop_dev</span>
              </div>
              <div class="meta-item">
                <span class="meta-lbl">ROBLOX GROUP</span>
                <span class="meta-val">Group ID 1111394813</span>
              </div>
              <div class="meta-item">
                <span class="meta-lbl">ACTIVE TRADERS</span>
                <span class="meta-val text-green">15,000+ Daily</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 广告位 1/2：Hero 卡片下方、正文之前。468x60 在窄屏由 AdSlot scoped CSS 隐藏，避免裁切；页尾第二位由 BaseLayout 统一挂载。 -->
        <AdSlot zone="banner-468x60" />

        <!-- SECTION 1: OVERVIEW -->
        <section id="discord-overview" style="margin-top: 3rem;">
          <h2>Aligators Games Discord Overview</h2>
          <p>
            The official community server hosted by <strong>Aligators Games</strong> serves as the central communications nervous system for <em>Cameraman Tower Defense</em>. Because the developers release rapid balancing hotfixes (such as the recent damage scaling increases for Executioner TV Man and Nightmare mode difficulty adjustments), joining the community channels ensures you never miss a balance patch or limited-time code drop.
          </p>
          <p>
            The server is organized into dedicated categories covering general chat, strategy discussions, speedrunning records, bug reports, and trading advertisements.
          </p>
        </section>

        <!-- SECTION 2: TRADING CHANNELS -->
        <section id="trading-channels" style="margin-top: 3.5rem;">
          <h2>Community Trading Channels & Etiquette</h2>
          <p>
            The trading category features high-volume channels dedicated to exchanging Godlies, Mythics, and limited event crates:
          </p>
          <ul>
            <li><strong>#trade-ads:</strong> Post what you are offering and looking for using standard trading nomenclature (e.g., <em>[H] UTCM + Chaos Cameraman [W] TV Spider</em>).</li>
            <li><strong>#value-discussion:</strong> Debate shifting market demands and check whether upcoming crate rotations will affect liquidity.</li>
            <li><strong>#w-f-l-checks:</strong> Get real-time second opinions from veteran traders before executing trades in the game lobby.</li>
          </ul>
        </section>

        <!-- SECTION 3: TRADE RULES -->
        <section id="trade-verification-rules" style="margin-top: 3.5rem;">
          <h2>Scam Prevention & Trade Rules</h2>
          <div class="rules-alert-box">
            <h3>Mandatory Trading Golden Rules:</h3>
            <ol>
              <li><strong>In-Game Window Only:</strong> Never accept off-site links, third-party trade bots, or promises of external currency. Always execute trades directly within the official Roblox trade window.</li>
              <li><strong>Verify Slot Equivalents:</strong> Cross-reference every trade against our <a href="/values/" style="color: #38bdf8;">Interactive Trade Calculator</a> to verify that the exchange satisfies the ±10% fair market band.</li>
              <li><strong>Check Unit Names Carefully:</strong> Scammers frequently attempt to substitute base units (such as <em>Titan Cameraman Base</em>) for high-value variants (<em>Upgraded Titan Cameraman</em>). Always read the unit rarity label in the confirmation screen.</li>
            </ol>
          </div>
        </section>

        <!-- SECTION 4: DEVELOPER ANNOUNCEMENTS -->
        <section id="developer-announcements" style="margin-top: 3.5rem;">
          <h2>Patch Notes & Code Giveaways</h2>
          <p>
            Developers <strong>aibat303e</strong> and <strong>iop_dev</strong> regularly host community milestone giveaways when the game surpasses visit benchmarks (such as the recent 70M visits milestone). Furthermore, new promo codes are announced first in the <code>#announcements</code> channel before propagating to gaming press.
          </p>
          <p>
            For instant access to all audited codes without needing to scroll through Discord message histories, check our daily-maintained <a href="/codes/" style="color: #38bdf8;">Promo Codes Tracker</a>.
          </p>
        </section>

        <!-- SECTION 5: TACTICAL ECOSYSTEM LINKS -->
        <section id="ecosystem-links" style="margin-top: 3.5rem;">
          <div class="discord-ecosystem-box">
            <div class="ecosystem-title">TACTICAL PROGRESSION // COMMUNITY ECOSYSTEM</div>
            <div class="ecosystem-links-grid">
              <div class="ecosystem-link-item">
                <span class="icon">⚖️</span>
                <div>
                  <strong>Trade Value Calculator</strong>
                  <p>Check live point values and verify fair trade margins before agreeing on deals in Discord trading channels on our <a href="/values/">CTD Values List</a>.</p>
                </div>
              </div>
              <div class="ecosystem-link-item">
                <span class="icon">🎁</span>
                <div>
                  <strong>Active Promo Codes</strong>
                  <p>Never miss developer coin giveaways announced in #announcements: copy verified drops on our <a href="/codes/">CTD Codes Tracker</a>.</p>
                </div>
              </div>
              <div class="ecosystem-link-item">
                <span class="icon">📊</span>
                <div>
                  <strong>Meta Tier Rankings</strong>
                  <p>Consult the post-buff Update 4 unit hierarchy to know which units to trade for in the <a href="/tier-list/">CTD Meta Tier List</a>.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 6: EVIDENCE DOSSIER -->
        <section id="evidence-dossier" style="margin-top: 3.5rem;">
          <h2>Verified Official Coordinates Dossier</h2>
          <div class="evidence-box">
            <div class="evidence-header">
              <span class="evidence-shield">🛡️ OFFICIAL COMMUNITY DOSSIER</span>
              <span class="evidence-status">CONFIRMED GENUINE</span>
            </div>
            <div class="evidence-body">
              <p><strong>Primary Developer Group:</strong> Aligators Games (Roblox Group ID: <code>1111394813</code>).</p>
              <p><strong>Associated Place ID:</strong> <code>132929771812494</code> (Universe ID: <code>10762636904</code>).</p>
              <p><strong>Anti-Spam Verification:</strong> Group membership requires standard Roblox Captcha to prevent botting.</p>
              <blockquote>
                <em>"Only rely on verified links found on the official Roblox game details page. Never join duplicate look-alike servers claiming to offer free admin units."</em>
              </blockquote>
            </div>
          </div>
        </section>
      </article>

      <!-- Sidebar -->
      <DualSidebar
        tocHeadings={tocHeadings}
        currentUrl="/discord/"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .hub-hero-card {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.5rem;
    background: #0f172a;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 12px;
    padding: 1.75rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 768px) {
    .hub-hero-card { grid-template-columns: 1fr; }
  }
  .hub-platform-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #38bdf8;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .hub-card-left h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.6rem;
    color: #f8fafc;
  }
  .hub-card-left p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
  }
  .hub-cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .quick-meta-box {
    background: #090e18;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    justify-content: center;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .meta-lbl {
    font-size: 0.7rem;
    color: #64748b;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.05em;
  }
  .meta-val {
    font-size: 1rem;
    font-weight: 700;
    color: #f1f5f9;
  }
  .text-green { color: #10b981; }

  .rules-alert-box {
    background: #0b1120;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 8px;
    padding: 1.25rem;
    margin-top: 1rem;
  }
  .rules-alert-box h3 {
    margin: 0 0 0.75rem 0;
    color: #fbbf24;
    font-size: 1.05rem;
  }
  .rules-alert-box ol {
    margin: 0;
    padding-left: 1.25rem;
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Evidence Box */
  .evidence-box {
    background: #0b1120;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 8px;
    padding: 1.25rem;
    margin-top: 1rem;
  }
  .evidence-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .evidence-shield {
    color: #38bdf8;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  .evidence-status {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .evidence-body p {
    font-size: 0.875rem;
    color: #cbd5e1;
    margin: 0.4rem 0;
  }
  .evidence-body code {
    background: #1e293b;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: #38bdf8;
  }
  .evidence-body blockquote {
    border-left: 3px solid #38bdf8;
    margin: 0.8rem 0 0 0;
    padding-left: 0.8rem;
    color: #94a3b8;
    font-size: 0.85rem;
    font-style: italic;
  }

  /* Tactical Ecosystem Box */
  .discord-ecosystem-box {
    background: #0f172a;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .ecosystem-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: #38bdf8;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 0.5rem;
  }
  .ecosystem-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .ecosystem-links-grid {
      grid-template-columns: 1fr;
    }
  }
  .ecosystem-link-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .ecosystem-link-item .icon {
    font-size: 1.25rem;
    line-height: 1;
    margin-top: 0.15rem;
  }
  .ecosystem-link-item strong {
    display: block;
    font-size: 0.9rem;
    color: #f1f5f9;
    margin-bottom: 0.25rem;
  }
  .ecosystem-link-item p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
  }
  .ecosystem-link-item a {
    color: #38bdf8;
    text-decoration: none;
  }
  .ecosystem-link-item a:hover {
    text-decoration: underline;
  }
</style>
